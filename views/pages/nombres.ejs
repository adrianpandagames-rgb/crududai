<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
    <link rel="stylesheet" href="/public/css/nombres.css" />
  </head>
  <body>
    <%- include('../includes/header') %>

    <main class="container page-offset">
      <div class="row justify-content-md-center mb-4">
        <div class="col-md-12 mt-5">
          <h2 class="text-center title">RASTROX <hr /></h2>
          <p class="text-center text-muted">Búsqueda por nombre, RFC, CURP o teléfono</p>
        </div>
      </div>

      <% if (message) { %>
        <div class="alert <%= messageType === 'error' ? 'alert-danger' : 'alert-success' %>"><%= message %></div>
      <% } %>

      <div class="row g-4 mb-4">
        <div class="col-lg-4">
          <div class="card p-4 mb-4">
            <form action="/nombres" method="GET" autocomplete="off">
              <div class="mb-3">
                <label for="q" class="form-label">Nombre completo, RFC, CURP o teléfono</label>
                <input type="text" id="q" name="q" class="form-control" maxlength="120" required value="<%= name %>" placeholder="ej. Luis Ramírez Gómez" />
              </div>
              <div class="mb-3">
                <label for="ciudad" class="form-label">Ciudad o estado (opcional)</label>
                <input type="text" id="ciudad" name="ciudad" class="form-control" maxlength="100" value="<%= city %>" placeholder="ej. Hermosillo" />
                <div class="form-text">Acota las búsquedas en Google y en DENUE; si incluye el estado, DENUE busca solo ahí.</div>
              </div>
              <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Buscar</button>
            </form>
          </div>

          <div class="card p-3 nombres-status">
            <h3 class="h6">Listas oficiales</h3>
            <% listStatus.forEach((list) => { %>
              <div class="mb-2">
                <div class="fw-semibold"><%= list.label %></div>
                <div class="small text-muted">
                  <% if (list.refreshing) { %>Actualizando…<% } else if (list.updatedAt) { %>
                    <%= list.entries.toLocaleString('es-MX') %> nombres · actualizada <%= list.updatedAt %>
                  <% } else { %>Todavía no se descarga.<% } %>
                </div>
                <% if (list.error) { %><div class="small text-danger">Último intento falló: <%= list.error %></div><% } %>
              </div>
            <% }) %>
            <% if (canRefresh) { %>
              <form action="/nombres/actualizar" method="POST" class="mt-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Actualizar listas ahora</button>
              </form>
            <% } %>
            <div class="mt-3">
              <div class="fw-semibold"><%= denueStatus.label %></div>
              <div class="small text-muted">
                <% if (denueStatus.progress?.indexing) { %>Preparando la búsqueda de <%= denueStatus.progress.entries.toLocaleString('es-MX') %> negocios…
                <% } else if (denueStatus.progress) { %>Descargando archivo <%= denueStatus.progress.file %> de <%= denueStatus.progress.files %> · <%= denueStatus.progress.entries.toLocaleString('es-MX') %> negocios cargados
                <% } else if (denueStatus.updatedAt) { %><%= denueStatus.entries.toLocaleString('es-MX') %> negocios · actualizado <%= denueStatus.updatedAt %>
                <% } else { %>Todavía no se descarga.<% } %>
              </div>
              <% if (denueStatus.error) { %><div class="small text-danger">Último intento falló: <%= denueStatus.error %></div><% } %>
              <% if (canRefresh && !denueStatus.refreshing) { %>
                <form action="/nombres/actualizar-denue" method="POST" class="mt-2">
                  <button type="submit" class="btn btn-sm btn-outline-secondary">Actualizar DENUE ahora</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-8">
          <% if (error) { %>
            <div class="alert alert-warning"><%= error %></div>
          <% } else if (!search) { %>
            <div class="card p-4 text-muted">
              Escribe un nombre completo para buscarlo en listas oficiales y en el directorio de negocios DENUE, y obtener búsquedas preparadas en Google y redes sociales.
              También puedes buscar un RFC o CURP en las listas, o un número telefónico o alias OSINT en los perfiles registrados.
            </div>
          <% } else { %>
            <% if (search.perfiles.length > 0 || !search.identifier) { %>
              <section class="card p-3 mb-4">
                <h3 class="h5">Perfiles registrados <span class="text-muted fw-normal">· <%= search.perfiles.length %> coincidencia(s)</span></h3>
                <% if (search.perfiles.length === 0) { %>
                  <p class="text-muted mb-0">No hay ningún perfil registrado con <%= search.phone ? 'esa línea' : 'ese nombre' %>.</p>
                <% } else { %>
                  <div class="table-responsive">
                    <table class="table nombres-table table-stack mb-0">
                      <thead><tr><th>Nombre</th><th>Dirección</th><th>Alias OSINT</th><th>Línea</th></tr></thead>
                      <tbody>
                        <% search.perfiles.forEach((perfil) => { %>
                          <tr>
                            <td data-label="Nombre">
                              <div class="fw-semibold"><%= perfil.nombre %></div>
                              <% if (!perfil.exact) { %><span class="nombres-badge approx" title="Coincide por parecido en escritura o sonido, no letra por letra">aproximada</span><% } %>
                              <div class="small text-muted">Registrado <%= perfil.createdAt %><%= perfil.createdBy ? ` por ${perfil.createdBy}` : '' %></div>
                              <% if ((perfil.imagenes || []).length > 0) { %>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                  <% perfil.imagenes.forEach((imagenId) => { %>
                                    <a href="/perfiles/imagenes/<%= imagenId %>" target="_blank" rel="noopener">
                                      <img src="/perfiles/imagenes/<%= imagenId %>" alt="Imagen del perfil" loading="lazy" width="56" height="56" style="object-fit: cover; border-radius: 6px;" />
                                    </a>
                                  <% }) %>
                                </div>
                              <% } %>
                            </td>
                            <td data-label="Dirección" class="nombres-details"><%= perfil.direccion || '—' %></td>
                            <td data-label="Alias OSINT" class="nombres-details"><%= perfil.alias || '—' %></td>
                            <td data-label="Línea" class="nombres-details"><%= perfil.linea %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </section>
            <% } %>

            <% if (!search.phone && !search.alias) { %>
            <section class="card p-3 mb-4">
              <h3 class="h5">Listas oficiales <span class="text-muted fw-normal">· <%= search.results.length %> coincidencia(s)</span></h3>
              <% if (listStatus.every((list) => !list.updatedAt)) { %>
                <div class="alert alert-info mb-0">Las listas se están descargando por primera vez. Vuelve a buscar en un minuto.</div>
              <% } else if (search.results.length === 0) { %>
                <p class="text-muted mb-0">No aparece en OFAC ni en SAT 69-B. Que no aparezca no descarta nada: estas listas solo incluyen a sancionados y empresas fantasma.</p>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table nombres-table table-stack mb-2">
                    <thead><tr><th>Lista</th><th>Nombre registrado</th><th>Datos</th></tr></thead>
                    <tbody>
                      <% search.results.forEach((result) => { %>
                        <tr>
                          <td data-label="Lista">
                            <span class="nombres-badge <%= result.source %>"><%= result.source === 'ofac' ? 'OFAC' : 'SAT 69-B' %></span>
                            <% if (!result.exact) { %><div><span class="nombres-badge approx" title="Coincide por parecido en escritura o sonido, no letra por letra">aproximada</span></div><% } %>
                          </td>
                          <td data-label="Nombre registrado">
                            <div class="fw-semibold"><%= result.name %></div>
                            <% if (result.details.aliasDe) { %><div class="small">Alias de <strong><%= result.details.aliasDe %></strong></div><% } %>
                            <div class="small text-muted"><%= result.details.tipo %></div>
                          </td>
                          <td data-label="Datos" class="nombres-details">
                            <% if (result.source === 'ofac') { %>
                              <% if (result.details.programa) { %><div><strong>Programa:</strong> <%= result.details.programa %></div><% } %>
                              <% if (result.details.cargo) { %><div><strong>Cargo:</strong> <%= result.details.cargo %></div><% } %>
                              <% if (result.details.notas) { %><div><%= result.details.notas %></div><% } %>
                            <% } else { %>
                              <div><strong>RFC:</strong> <%= result.details.rfc %></div>
                              <div><strong>Situación:</strong> <%= result.details.situacion || '—' %></div>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
                <p class="small text-muted mb-0">Una coincidencia de nombre no confirma identidad: compara fecha de nacimiento, CURP o RFC antes de usarla.</p>
              <% } %>
            </section>
            <% } %>

            <% if (search.denue) { %>
              <section class="card p-3 mb-4">
                <h3 class="h5">Negocios en DENUE (INEGI) <span class="text-muted fw-normal">· <%= search.denue.results.length %> coincidencia(s)</span></h3>
                <% if (search.denue.error) { %>
                  <div class="alert alert-warning mb-0"><%= search.denue.error %></div>
                <% } else if (!denueStatus.updatedAt) { %>
                  <div class="alert alert-info mb-0">El DENUE se está descargando por primera vez; tarda entre 20 y 60 minutos. Vuelve a buscar después.</div>
                <% } else if (search.denue.results.length === 0) { %>
                  <p class="text-muted mb-0">No aparece como nombre ni razón social de ningún negocio registrado. DENUE solo incluye establecimientos, no personas.</p>
                <% } else { %>
                  <div class="table-responsive">
                    <table class="table nombres-table table-stack mb-2">
                      <thead><tr><th>Negocio</th><th>Dirección</th><th>Contacto</th></tr></thead>
                      <tbody>
                        <% search.denue.results.forEach((result) => { %>
                          <tr>
                            <td data-label="Negocio">
                              <div class="fw-semibold"><%= result.nombre %></div>
                              <% if (result.razonSocial && result.razonSocial !== result.nombre) { %><div class="small">Razón social: <strong><%= result.razonSocial %></strong></div><% } %>
                              <div class="small text-muted"><%= result.actividad %><% if (result.personal) { %> · <%= result.personal %><% } %></div>
                              <% if (result.inPlace) { %><span class="nombres-badge denue"><%= search.city %></span><% } %>
                            </td>
                            <td data-label="Dirección" class="nombres-details">
                              <div><%= result.direccion || '—' %></div>
                              <div><%= [result.colonia, result.cp && `C.P. ${result.cp}`].filter(Boolean).join(', ') %></div>
                              <div class="text-muted"><%= result.ubicacion %></div>
                              <% if (result.latitud && result.longitud) { %>
                                <a href="https://www.google.com/maps?q=<%= encodeURIComponent(`${result.latitud},${result.longitud}`) %>" target="_blank" rel="noopener noreferrer">Ver en mapa</a>
                              <% } %>
                            </td>
                            <td data-label="Contacto" class="nombres-details">
                              <% if (result.telefono) { %><div><strong>Tel.:</strong> <%= result.telefono %></div><% } %>
                              <% if (result.correo) { %><div><strong>Correo:</strong> <%= result.correo %></div><% } %>
                              <% if (result.sitio) { %><div><strong>Web:</strong> <%= result.sitio %></div><% } %>
                              <% if (!result.telefono && !result.correo && !result.sitio) { %><span class="text-muted">—</span><% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <p class="small text-muted mb-0">Que un negocio lleve el mismo nombre no confirma que sea la misma persona.</p>
                <% } %>
              </section>
            <% } %>

            <% if (search.links.length > 0) { %>
              <section class="card p-3 mb-4">
                <h3 class="h5">Búsquedas preparadas</h3>
                <p class="small text-muted">Se abren en otra pestaña con tu propia sesión de cada sitio.</p>
                <% search.links.forEach((group) => { %>
                  <div class="mb-3">
                    <div class="small fw-semibold mb-1"><%= group.group %></div>
                    <div class="d-flex flex-wrap gap-2">
                      <% group.links.forEach((link) => { %>
                        <a class="btn btn-sm btn-outline-primary" href="<%= link.href %>" target="_blank" rel="noopener noreferrer"><%= link.name %></a>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
              </section>
            <% } %>

            <% if (search.variants.length > 0 && maigretAvailable) { %>
              <section class="card p-3">
                <h3 class="h5">Probar usuarios probables en Maigret</h3>
                <p class="small mb-2">
                  Usuarios que suelen formarse con este nombre:
                  <% search.variants.forEach((variant) => { %><code class="me-2"><%= variant %></code><% }) %>
                </p>
                <p class="small text-muted">Útil con nombres poco comunes. Con nombres comunes encontrará cuentas de muchas personas distintas. Se usa la búsqueda rápida sin seguir alias.</p>
                <form action="/nombres/maigret" method="POST" class="m-0">
                  <input type="hidden" name="nombre" value="<%= search.name %>" />
                  <button type="submit" class="btn btn-outline-primary">Enviar <%= search.variants.length %> usuarios a Maigret</button>
                </form>
              </section>
            <% } %>
          <% } %>
        </div>
      </div>
    </main>
    <% if ((listStatus.some((list) => list.refreshing) || denueStatus.refreshing) && !search) { %>
      <script>setTimeout(() => { if (!document.getElementById('q').value) window.location.reload(); }, 15000);</script>
    <% } %>
    <%- include('../includes/scripts') %>
    <%- include('../includes/footer') %>
  </body>
</html>
