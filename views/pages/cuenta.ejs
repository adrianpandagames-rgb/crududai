<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container page-offset">
      <div class="row justify-content-md-center">
        <div class="col-lg-8 mt-5">
          <h1 class="title text-center mb-4">Mi cuenta</h1>
          <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
          <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

          <section class="card p-4 mb-4" aria-labelledby="perfil-titulo">
            <h2 class="h5 mb-3" id="perfil-titulo">Perfil</h2>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
              <% if (cuenta.fotoVersion) { %>
              <img src="/cuenta/foto?v=<%= cuenta.fotoVersion %>" alt="Tu foto" width="96" height="96" class="rounded-circle" style="object-fit: cover;" />
              <% } else { %>
              <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white fs-2"
                style="width: 96px; height: 96px; background: #198754;" aria-hidden="true"><%= ((cuenta.nombre || email)[0] || '?').toUpperCase() %></span>
              <% } %>
              <div class="flex-fill">
                <div class="fw-semibold"><%= cuenta.nombre || 'Sin nombre' %></div>
                <div class="text-muted small"><%= email %></div>
              </div>
            </div>

            <form action="/cuenta/foto" method="POST" enctype="multipart/form-data" class="mb-3">
              <label for="foto" class="form-label">Foto</label>
              <div class="d-flex flex-wrap gap-2">
                <input type="file" id="foto" name="foto" class="form-control flex-fill w-auto" accept="image/jpeg,image/png,image/webp,image/gif" required aria-describedby="fotoAyuda" />
                <button class="btn btn-primary" type="submit">Subir foto</button>
              </div>
              <div id="fotoAyuda" class="form-text">JPG, PNG, WebP o GIF de hasta <%= maxFotoMb %> MB. Se recorta en cuadro y se le quitan los datos de ubicación.</div>
            </form>
            <% if (cuenta.fotoVersion) { %>
            <form action="/cuenta/foto/eliminar" method="POST" class="mb-3">
              <button class="btn btn-outline-danger btn-sm" type="submit">Quitar foto</button>
            </form>
            <% } %>

            <form action="/cuenta/nombre" method="POST" autocomplete="off">
              <label for="nombre" class="form-label">Nombre</label>
              <div class="d-flex flex-wrap gap-2">
                <input type="text" id="nombre" name="nombre" class="form-control flex-fill w-auto" maxlength="<%= MAX_NOMBRE_LENGTH %>" value="<%= cuenta.nombre %>" aria-describedby="nombreAyuda" />
                <button class="btn btn-primary" type="submit">Guardar nombre</button>
              </div>
              <div id="nombreAyuda" class="form-text">Opcional. Si lo dejas vacío, se muestra tu correo.</div>
            </form>
          </section>

          <section class="card p-4 mb-4" id="contrasena" aria-labelledby="contrasena-titulo">
            <h2 class="h5 mb-3" id="contrasena-titulo">Contraseña</h2>
            <form action="/cuenta/contrasena" method="POST">
              <div class="mb-3">
                <label class="form-label" for="currentPassword">Contraseña actual</label>
                <input class="form-control" type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password" />
              </div>
              <div class="row">
                <div class="col-sm-6 mb-3">
                  <label class="form-label" for="password">Nueva contraseña</label>
                  <input class="form-control" type="password" id="password" name="password" minlength="8" required autocomplete="new-password" />
                </div>
                <div class="col-sm-6 mb-3">
                  <label class="form-label" for="confirmPassword">Confirmar nueva contraseña</label>
                  <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" minlength="8" required autocomplete="new-password" />
                </div>
              </div>
              <p class="small text-muted">Al cambiarla se cierran tus sesiones abiertas en otros equipos.</p>
              <button class="btn btn-primary" type="submit">Cambiar contraseña</button>
            </form>
          </section>

          <section class="card p-4 mb-4" id="dos-pasos" aria-labelledby="dos-pasos-titulo">
            <h2 class="h5 mb-2" id="dos-pasos-titulo">Verificación en dos pasos</h2>
            <% const fecha = (valor) => valor ? new Date(valor).toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' }) : 'Nunca'; %>
            <% if (codigos && codigos.length) { %>
            <div class="alert alert-warning" role="alert">
              <p class="fw-semibold mb-2">Tus códigos de recuperación. Guárdalos ahora: no se volverán a mostrar.</p>
              <p class="small mb-2">Cada uno sirve una sola vez para entrar si no tienes tu dispositivo a la mano.</p>
              <ul class="list-unstyled font-monospace row row-cols-2 mb-0">
                <% codigos.forEach((codigo) => { %><li class="col"><%= codigo %></li><% }) %>
              </ul>
            </div>
            <% } %>
            <% if (passkeys.length) { %>
            <p class="mb-3"><span class="badge bg-success">Activada</span> Al iniciar sesión se pide, además de la contraseña, una de estas llaves de acceso.
              Te quedan <%= codigosRestantes %> códigos de recuperación sin usar.</p>
            <ul class="list-group mb-3">
              <% passkeys.forEach((passkey) => { %>
              <li class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold"><%= passkey.nombre %></div>
                    <div class="small text-muted">Agregada: <%= fecha(passkey.creada) %> · Último uso: <%= fecha(passkey.usada) %></div>
                  </div>
                  <% if (dosPasosObligatorio && passkeys.length === 1) { %>
                  <span class="small text-muted align-self-center">Es obligatoria: agrega otra para poder quitar esta.</span>
                  <% } else { %>
                  <details>
                    <summary class="btn btn-sm btn-outline-danger">Quitar</summary>
                    <form action="/cuenta/dos-pasos/<%= passkey.id %>/eliminar" method="POST" class="mt-2">
                      <label class="form-label small" for="quitar-<%= passkey.id %>">Contraseña actual</label>
                      <input class="form-control form-control-sm mb-2" type="password" id="quitar-<%= passkey.id %>" name="currentPassword" required autocomplete="current-password" />
                      <button class="btn btn-sm btn-danger" type="submit">Quitar llave</button>
                    </form>
                  </details>
                  <% } %>
                </div>
              </li>
              <% }) %>
            </ul>
            <% } else { %>
            <p class="mb-3"><span class="badge bg-secondary">Desactivada</span> Agrega una llave de acceso para que, además de la contraseña,
              se pida la huella, el rostro o el PIN de tu celular o computadora al iniciar sesión.</p>
            <% } %>

            <% if (dosPasosDisponible) { %>
            <form id="registrarPasskey" autocomplete="off" class="mb-3">
              <label for="passkeyNombre" class="form-label">Nombre del dispositivo</label>
              <div class="d-flex flex-wrap gap-2">
                <input type="text" id="passkeyNombre" name="nombre" class="form-control flex-fill w-auto" maxlength="80" placeholder="Ej. Mi celular" />
                <button class="btn btn-primary" type="submit">Agregar este dispositivo</button>
              </div>
              <div class="form-text">Ábrelo desde el celular para usar su huella o rostro. Desde una computadora puedes usar Windows Hello o escanear un código QR con el celular.</div>
              <div class="alert alert-danger mt-2 mb-0" id="registrarPasskeyError" role="alert" hidden></div>
            </form>
            <% } else { %>
            <p class="small text-muted">Las llaves de acceso no están disponibles en este servidor: falta configurar su dominio.</p>
            <% } %>

            <% if (passkeys.length) { %>
            <details>
              <summary class="small">Generar códigos de recuperación nuevos</summary>
              <form action="/cuenta/dos-pasos/codigos" method="POST" class="mt-2">
                <label class="form-label small" for="codigosPassword">Contraseña actual</label>
                <div class="d-flex flex-wrap gap-2">
                  <input class="form-control form-control-sm flex-fill w-auto" type="password" id="codigosPassword" name="currentPassword" required autocomplete="current-password" />
                  <button class="btn btn-sm btn-outline-primary" type="submit">Generar códigos</button>
                </div>
                <div class="form-text">Los códigos anteriores dejarán de servir.</div>
              </form>
            </details>
            <% } %>
          </section>

          <section class="card p-4 mb-4" id="preferencias" aria-labelledby="preferencias-titulo">
            <h2 class="h5 mb-3" id="preferencias-titulo">Preferencias</h2>
            <form action="/cuenta/preferencias" method="POST">
              <div class="row">
                <div class="col-sm-6 mb-3">
                  <label for="tema" class="form-label">Tema</label>
                  <select id="tema" name="tema" class="form-select">
                    <% Object.entries(temas).forEach(([value, label]) => { %>
                    <option value="<%= value %>"<%= cuenta.preferencias.tema === value ? ' selected' : '' %>><%= label %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-sm-6 mb-3">
                  <label for="inicio" class="form-label">Página al iniciar sesión</label>
                  <select id="inicio" name="inicio" class="form-select">
                    <% paginasInicio.forEach(({ path, label }) => { %>
                    <option value="<%= path %>"<%= cuenta.preferencias.inicio === path ? ' selected' : '' %>><%= label %></option>
                    <% }) %>
                  </select>
                </div>
              </div>
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="avisos" name="avisos" value="1"<%= cuenta.preferencias.avisos ? ' checked' : '' %> />
                <label class="form-check-label" for="avisos">Mostrar avisos emergentes</label>
                <div class="form-text">Si los desactivas, los avisos se siguen guardando en tus notificaciones.</div>
              </div>
              <button class="btn btn-primary" type="submit">Guardar preferencias</button>
            </form>
          </section>

          <section class="card p-4 mb-4" aria-labelledby="notificaciones-titulo">
            <h2 class="h5 mb-2" id="notificaciones-titulo">Notificaciones</h2>
            <% const unread = Number(currentUser.noLeidas) || 0; %>
            <p class="mb-3"><%= unread ? `Tienes ${unread} sin leer.` : 'No tienes notificaciones sin leer.' %></p>
            <a class="btn btn-outline-primary align-self-start" href="/cuenta/notificaciones">Ver notificaciones</a>
          </section>
        </div>
      </div>
    </main>
    <%- include('../includes/scripts') %>
    <% if (dosPasosDisponible) { %>
    <script src="/vendor/simplewebauthn-browser.js"></script>
    <script src="/public/js/dos-pasos.js"></script>
    <% } %>
    <%- include('../includes/footer') %>
  </body>
</html>
