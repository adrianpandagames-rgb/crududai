<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>

    <main class="container page-offset">
      <div class="row justify-content-md-center mb-5">
        <div class="col-md-12 mt-5">
          <h2 class="text-center title">GEOREFERENCIACIÓN <hr /></h2>
        </div>
      </div>

      <% if (!configured) { %>
        <div class="alert alert-warning">La geocodificación no está configurada. Solicita al administrador configurar la clave de Google Geocoding en el servidor.</div>
      <% } %>
      <% if (typeof googleGeocodingQuota !== 'undefined') { %>
        <% if (googleGeocodingQuota.isBlocked) { %>
          <div class="alert alert-danger" role="alert">ALARMA: se alcanzó el límite de <%= googleGeocodingQuota.limit %> consultas a Google Geocoding. El servicio está bloqueado; solicita a un administrador reiniciar el contador.</div>
        <% } else { %>
          <p class="text-muted text-center">Consultas a Google Geocoding: <%= googleGeocodingQuota.requestCount %> / <%= googleGeocodingQuota.limit %></p>
        <% } %>
      <% } %>
      <p class="text-muted text-center">Direcciones obtenidas mediante Google Maps. Tus archivos estarán disponibles durante 48 horas.</p>
      <% if (message) { %>
        <div class="alert <%= messageType === 'error' ? 'alert-danger' : 'alert-success' %>"><%= message %></div>
      <% } %>

      <div class="row justify-content-md-center mb-4">
        <div class="col-md-5 mb-4">
          <div class="card p-4">
            <h3 class="text-center mb-4">Importar archivo</h3>
            <form action="/georeferenciacion/importar" method="POST" enctype="multipart/form-data">
              <div class="mb-3">
                <label for="linea" class="form-label">Número de línea</label>
                <input type="text" id="linea" name="linea" class="form-control" maxlength="50" required autocomplete="off" />
              </div>
              <div class="mb-3">
                <label for="archivo" class="form-label">Archivo CSV o Excel (.xlsx)</label>
                <input type="file" id="archivo" name="archivo" class="form-control" accept=".csv,text/csv,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                <div class="form-text">Incluye columnas latitud y longitud (decimales o grados, minutos y segundos). Máximo 20 MB y 100000 filas. </div>
              </div>
              <button type="submit" class="btn btn-primary w-100" <%= configured && (typeof googleGeocodingQuota === 'undefined' || !googleGeocodingQuota.isBlocked) ? '' : 'disabled' %>>Importar y geocodificar</button>

            </form>
          </div>
        </div>

        <div class="col-md-7 py-3 custom_table">
          <h3 class="text-center">Archivos de Georeferenciación</h3>
          <div class="table-responsive">
            <table class="table w-100 ruta-files-table">
              <thead>
                <tr>
                  <th>Archivo</th>
                  <th>Línea</th>
                  <th>Estado</th>
                  <th>Acción</th>
                </tr>
              </thead>
              <tbody>
                <% if (!files || files.length === 0) { %>
                  <tr><td colspan="4" class="text-center">No hay archivos importados</td></tr>
                <% } else { %>
                  <% files.forEach((file) => { %>
                    <tr id="ruta-file-<%= file.id %>">
                      <td><%= file.name %></td>
                      <td><%= file.lineNumber %></td>
                      <td>
                        <% if (file.status === 'listo') { %>
                          <span class="ruta-status-dot ruta-status-ready" title="Listo" aria-label="Listo"></span>
                        <% } else if (file.status === 'error') { %>
                          <span class="ruta-status-dot ruta-status-error" title="Error: <%= file.error %>" aria-label="Error"></span>
                        <% } else { %>
                          <span class="ruta-status-dot ruta-status-pending" title="En proceso" aria-label="En proceso"></span>
                        <% } %>
                        <div class="small"><%= file.processed %> / <%= file.total %> filas</div>
                        <% if (file.status === 'error') { %><div class="small text-danger"><%= file.error %></div><% } %>
                      </td>
                      <td class="ruta-actions">
                        <div class="d-flex align-items-center gap-2 flex-nowrap">
                        <% if (file.status === 'listo') { %>
                          <a class="btn btn-sm btn-outline-primary" href="/georeferenciacion/exportar-xlsx/<%= file.id %>">Exportar XLSX</a>
                          <a class="btn btn-sm btn-outline-primary" href="/georeferenciacion/exportar/<%= file.id %>">CSV</a>
                        <% } else { %>
                          <button type="button" class="btn btn-sm btn-secondary" disabled>Exportar XLSX</button>
                        <% } %>
                        <form action="/georeferenciacion/eliminar/<%= file.id %>" method="POST" class="m-0 flex-shrink-0" data-confirm="¿Eliminar este archivo de Georeferenciación?">
                          <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Eliminar archivo" title="Eliminar archivo">
                            <i class="bi bi-trash3" aria-hidden="true"></i>
                          </button>
                        </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="ruta-status-legend" aria-label="Significado de estados">
            <span><i class="ruta-status-dot ruta-status-ready" aria-hidden="true"></i> Listo</span>
            <span><i class="ruta-status-dot ruta-status-pending" aria-hidden="true"></i> En proceso</span>
            <span><i class="ruta-status-dot ruta-status-error" aria-hidden="true"></i> Error</span>
          </div>
        </div>
      </div>
      <section class="card p-4 mb-4" aria-labelledby="saved-locations-title">
        <h3 id="saved-locations-title">Ubicaciones georreferenciadas</h3>
        <p class="text-muted">Los resultados obtenidos con Google se guardan aquí, aunque elimines el archivo importado.</p>
        <form method="GET" action="/georeferenciacion" class="d-flex gap-2 mb-3">
          <label for="geo-search" class="visually-hidden">Buscar ubicación, lugar o coordenadas</label>
          <input id="geo-search" name="search" class="form-control" maxlength="200" value="<%= search %>" placeholder="Buscar ubicación, lugar o coordenadas" />
          <button class="btn btn-primary" type="submit">Buscar</button>
          <a class="btn btn-outline-secondary" href="/georeferenciacion">Limpiar</a>
        </form>
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Ubicación</th><th>Lugar</th><th>Entre calle</th><th>Y calle</th><th>Entrecalles</th><th>Latitud</th><th>Longitud</th></tr></thead>
            <tbody>
              <% locations.forEach((location) => { %>
                <tr><td><%= location.ubicacion %></td><td><%= location.lugar %></td><td><%= location.entre_calle_1 || '' %></td><td><%= location.entre_calle_2 || '' %></td><td><%= location.estado_entrecalles === 'ENCONTRADAS' ? 'Encontradas (sugeridas)' : location.estado_entrecalles === 'SERVICIO_NO_DISPONIBLE' ? 'Servicio no disponible' : 'Requiere revisión' %></td><td><%= location.latitude %></td><td><%= location.longitude %></td></tr>
              <% }); %>
              <% if (!locations.length) { %><tr><td colspan="7" class="text-center">No hay ubicaciones para mostrar.</td></tr><% } %>
            </tbody>
          </table>
        </div>
        <p class="text-muted small">Entrecalles sugeridas automáticamente; verifica antes de utilizarlas. Datos viales: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>. Si faltan datos o hay cruces ambiguos, se solicita revisión.</p>
        <nav class="d-flex align-items-center gap-3" aria-label="Páginas de ubicaciones">
          <% if (page > 1) { %><a href="/georeferenciacion?<%= new URLSearchParams({ search, page: page - 1 }).toString() %>">Anterior</a><% } %>
          <span><%= total %> registros · Página <%= page %> de <%= pages %></span>
          <% if (page < pages) { %><a href="/georeferenciacion?<%= new URLSearchParams({ search, page: page + 1 }).toString() %>">Siguiente</a><% } %>
        </nav>
      </section>
    </main>

    <% if (files.some((file) => file.status === 'pendiente')) { %>
      <script>
        setTimeout(() => window.location.reload(), 5000);
      </script>
    <% } %>

  </body>
</html>
