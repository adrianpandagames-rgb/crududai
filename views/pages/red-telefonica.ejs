<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
    <link rel="stylesheet" href="/public/css/red-telefonica.css" />
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container-fluid py-4 network-page">
      <div class="network-header">
        <div>
          <h2 class="title mb-1">Red de cruces telefónicos</h2>
          <p>Objetivos, sus contactos y las líneas que los conectan entre sí.</p>
        </div>
        <div class="network-legend" aria-label="Leyenda de la gráfica">
          <span class="legend-item"><span class="legend-dot objective"></span>Objetivo</span>
          <span class="legend-item"><span class="legend-dot crossing"></span>Contacto en cruce</span>
          <span class="legend-item"><span class="legend-dot"></span>Contacto</span>
          <span class="legend-item"><span class="legend-dot owner"></span>Contacto que es línea objetivo</span>
        </div>
      </div>

      <form id="networkSearch" class="network-toolbar" autocomplete="off">
        <div class="input-group network-search">
          <input id="networkNumber" type="search" inputmode="numeric" class="form-control" placeholder="Buscar línea (objetivo o contacto)" value="<%= initialNumber %>" aria-label="Línea a buscar" />
          <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Enfocar</button>
        </div>
        <button id="networkReset" type="button" class="btn btn-outline-secondary">Red general</button>
        <select id="networkLayout" class="form-select network-layout" aria-label="Acomodo de la red">
          <option value="auto">Automático</option>
          <option value="breadthfirst">Jerárquica</option>
          <option value="concentric">Anillos</option>
          <option value="cose">Orgánica (redes chicas)</option>
        </select>
        <label class="form-check network-check">
          <input id="networkAuto" class="form-check-input" type="checkbox" checked />
          <span class="form-check-label">Actualizar cada minuto</span>
        </label>
        <button id="networkPng" type="button" class="btn btn-outline-secondary"><i class="bi bi-download"></i> Imagen</button>
      </form>

      <div id="networkStatus" class="network-status" aria-live="polite"></div>

      <div class="network-layout-grid">
        <section class="network-shell">
          <div id="networkGraph" class="network-scroll" role="img" aria-label="Red de cruces telefónicos"></div>
        </section>
        <aside id="networkPanel" class="network-panel">
          <div class="network-panel-empty">Selecciona un nodo para ver su detalle. Doble clic sobre una línea para enfocarla.</div>
        </aside>
      </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>
    <script src="/public/js/red-telefonica.js"></script>
    <%- include('../includes/scripts') %>
  </body>
</html>
