<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container page-offset">
      <div class="row justify-content-md-center">
        <div class="col-md-6 mt-5">
          <div class="card p-4">
            <h1 class="text-center title">
              Editar perfil
              <% if (perfil.nombre) { %><span class="d-block fs-6 fw-normal text-muted mt-1"><%= perfil.nombre %></span><% } %>
            </h1>
            <p class="small text-muted mb-3"><span class="text-danger" aria-hidden="true">*</span> Campo obligatorio</p>
            <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
            <form action="/perfiles/<%= perfil.id %>/editar" method="POST" autocomplete="off">
              <input type="hidden" name="volver" value="<%= locals.volver || '' %>" />
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre <span class="text-danger" aria-hidden="true">*</span></label>
                <input type="text" id="nombre" name="nombre" class="form-control" maxlength="200" required value="<%= perfil.nombre %>" />
              </div>
              <div class="mb-3">
                <label for="direccion" class="form-label">Dirección</label>
                <textarea id="direccion" name="direccion" class="form-control" rows="3" maxlength="500"><%= perfil.direccion %></textarea>
              </div>
              <div class="mb-3">
                <label for="alias" class="form-label">Alias OSINT</label>
                <input type="text" id="alias" name="alias" class="form-control" maxlength="500" value="<%= perfil.alias || '' %>" aria-describedby="aliasAyuda" />
                <div id="aliasAyuda" class="form-text">Cómo aparece en Telegram, WhatsApp u otras apps.</div>
              </div>
              <div class="mb-3">
                <label for="linea" class="form-label">Línea telefónica <span class="text-danger" aria-hidden="true">*</span></label>
                <input type="text" id="linea" name="linea" class="form-control" maxlength="50" required value="<%= perfil.linea %>" />
              </div>
              <div class="d-flex gap-2">
                <a class="btn btn-secondary flex-fill" href="/perfiles?<%= locals.volver ? `${locals.volver}&` : '' %>abierto=<%= perfil.id %>#perfil-<%= perfil.id %>">Cancelar</a>
                <button class="btn btn-primary flex-fill" type="submit">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    <%- include('../includes/scripts') %>
    <%- include('../includes/footer') %>
  </body>
</html>
