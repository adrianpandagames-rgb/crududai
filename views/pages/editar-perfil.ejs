<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container page-offset">
      <div class="row justify-content-md-center">
        <div class="col-md-6 mt-5">
          <div class="card p-4">
            <h2 class="text-center title">Editar perfil</h2>
            <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
            <form action="/perfiles/<%= perfil.id %>/editar" method="POST" autocomplete="off">
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input type="text" id="nombre" name="nombre" class="form-control" maxlength="200" required value="<%= perfil.nombre %>" />
              </div>
              <div class="mb-3">
                <label for="direccion" class="form-label">Dirección</label>
                <textarea id="direccion" name="direccion" class="form-control" rows="3" maxlength="500"><%= perfil.direccion %></textarea>
              </div>
              <div class="mb-3">
                <label for="alias" class="form-label">Alias OSINT</label>
                <input type="text" id="alias" name="alias" class="form-control" maxlength="500" value="<%= perfil.alias || '' %>" />
                <div class="form-text">Cómo aparece en Telegram, WhatsApp u otras apps.</div>
              </div>
              <div class="mb-3">
                <label for="linea" class="form-label">Línea telefónica</label>
                <input type="text" id="linea" name="linea" class="form-control" maxlength="50" required value="<%= perfil.linea %>" />
              </div>
              <div class="d-flex gap-2">
                <a class="btn btn-secondary flex-fill" href="/perfiles">Cancelar</a>
                <button class="btn btn-primary flex-fill" type="submit">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    <%- include('../includes/scripts') %>
  </body>
</html>
