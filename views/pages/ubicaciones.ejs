<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>

    <script src="/public/js/clipboard-utils.js"></script>

    <% if (typeof currentUser !== 'undefined' && currentUser.isAdmin === true) { %>
    <dialog id="editLocationModal" class="ruta-delete-modal" aria-labelledby="editLocationTitle">
      <h3 id="editLocationTitle" class="h5">Modificar ubicación</h3>
      <form id="editLocationForm" method="POST">
        <div class="mb-3">
          <label for="editLocationCoordinates" class="form-label">Coordenadas</label>
          <input id="editLocationCoordinates" name="coordinates" class="form-control" required />
        </div>
        <div class="mb-3">
          <label for="editLocationName" class="form-label">Ubicación</label>
          <input id="editLocationName" name="ubicacion" class="form-control" required />
        </div>
        <div class="mb-3">
          <label for="editLocationPlace" class="form-label">Lugar (ciudad y estado)</label>
          <input id="editLocationPlace" name="lugar" class="form-control" required />
        </div>
        <p id="editLocationError" class="text-danger" role="alert" hidden></p>
        <div class="d-flex justify-content-end gap-2">
          <button type="submit" id="editLocationSave" class="btn btn-primary">Guardar cambios</button>
          <button type="button" id="editLocationCancel" class="btn btn-secondary">Cancelar</button>
        </div>
      </form>
    </dialog>
    <script src="/public/js/ubicaciones-edit.js"></script>
    <% } %>

    <div class="container page-offset ubicaciones-container">
      <div class="row justify-content-md-center mb-5">
        <div class="col-md-12 mt-5">
          <h2 class="text-center title">
            REGISTRO DE ANTENAS DE RADIOFRECUENCIA (POSICIONAMIENTO GEOGRÁFICO)
            <hr />
          </h2>
        </div>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
      <div class="row justify-content-md-center mb-4">
        <div class="col-md-12">
          <div class="alert <%= messageType === 'error' ? 'alert-danger' : 'alert-success' %>">
            <%= message %>
          </div>
        </div>
      </div>
      <% } %>

      <div class="row justify-content-md-center mb-4">
        <% if (typeof currentUser === 'undefined' || currentUser.role !== 'uecs') { %>
        <div class="col-md-4 mb-4">
          <div class="card p-4">
            <h3 class="text-center mb-4">Agregar ubicación</h3>
            <form action="/ubicaciones/register" method="POST">
              <div class="mb-3">
                <label for="coordinates" class="form-label">Coordenadas</label>
                <input type="text" id="coordinates" name="coordinates" class="form-control" placeholder="Ej. 19.432608, -99.133209 o 29°10'12.84&quot;N 111°1'21.01&quot;W" required autocomplete="off" autocapitalize="none" spellcheck="false" />
                <div class="form-text">Ingresa latitud y longitud en el mismo campo, separadas por coma o espacio. También aceptamos formato DMS como 29°10'12.84&quot;N 111°1'21.01&quot;W.</div>
              </div>
              <div class="mb-3">
                <label class="form-label">Mapa</label>
                <div id="map" class="location-map"></div>
                <div class="form-text">Haz clic en el mapa para seleccionar una ubicación.</div>
              </div>
              <div class="mb-3">
                <label for="ubicacion" class="form-label">Ubicación</label>
                <input type="text" id="ubicacion" name="ubicacion" class="form-control" placeholder="Nombre de la ubicación" required autocomplete="off" autocapitalize="none" spellcheck="false" />
              </div>
              <div class="mb-3">
                <label for="estadoBusqueda" class="form-label">Estado de México</label>
                <div class="position-relative">
                  <input type="text" id="estadoBusqueda" class="form-select" placeholder="Buscar y seleccionar estado" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="estadoOpciones" autocomplete="off" required disabled />
                  <div id="estadoOpciones" role="listbox" aria-label="Estados" class="position-absolute w-100 bg-white border rounded shadow-sm" style="max-height: 240px; overflow-y: auto; z-index: 1000" hidden></div>
                </div>
                <input type="hidden" id="estado" name="estado" />
              </div>
              <div class="mb-3">
                <label for="localidadBusqueda" class="form-label">Ciudad o localidad</label>
                <div class="position-relative" id="localidadCombobox">
                  <input type="text" id="localidadBusqueda" class="form-select" placeholder="Buscar y seleccionar localidad" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="localidadOpciones" aria-describedby="localidadEstado" autocomplete="off" required disabled />
                  <div id="localidadOpciones" role="listbox" aria-label="Localidades" class="position-absolute w-100 bg-white border rounded shadow-sm" style="max-height: 240px; overflow-y: auto; z-index: 1000" hidden></div>
                </div>
                <select id="lugar" name="lugar" hidden disabled>
                  <option value="" disabled selected>Selecciona primero un estado</option>
                </select>
                <div id="localidadEstado" class="form-text" role="status">Busca y selecciona una opción de la lista.</div>
              </div>
              <button type="submit" class="btn btn-primary w-100">Registrar ubicación</button>
            </form>

            <script>
              const estadoSelect = document.getElementById('estado');
              const ciudadSelect = document.getElementById('lugar');
              const estadoBusqueda = document.getElementById('estadoBusqueda');
              const estadoOpciones = document.getElementById('estadoOpciones');
              let estadoActiveIndex = -1;
              const localidadBusqueda = document.getElementById('localidadBusqueda');
              const localidadEstado = document.getElementById('localidadEstado');
              const localidadOpciones = document.getElementById('localidadOpciones');
              let selectedLocalidad = '';
              let activeIndex = -1;
              const cerrarLocalidades = () => {
                localidadOpciones.hidden = true;
                localidadBusqueda.setAttribute('aria-expanded', 'false');
                localidadBusqueda.removeAttribute('aria-activedescendant');
              };
              let estados = [];
              let localidades = [];
              let requestVersion = 0;

              const loadStates = async () => {
                const response = await fetch('/api/localidades');
                if (!response.ok) throw new Error('No se pudieron cargar los estados');
                const data = await response.json();
                estados = data.estados || [];
                estadoBusqueda.disabled = estados.length === 0;
                estadoBusqueda.setCustomValidity('Selecciona un estado de la lista.');
              };

              const normalizeText = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
              const cerrarEstados = () => {
                estadoOpciones.hidden = true;
                estadoBusqueda.setAttribute('aria-expanded', 'false');
                estadoBusqueda.removeAttribute('aria-activedescendant');
              };
              const seleccionarEstado = value => {
                estadoSelect.value = value;
                estadoBusqueda.value = value;
                estadoBusqueda.setCustomValidity('');
                cerrarEstados();
                estadoSelect.dispatchEvent(new Event('change'));
              };
              const filtrarEstados = () => {
                estadoActiveIndex = -1;
                estadoBusqueda.removeAttribute('aria-activedescendant');
                estadoOpciones.replaceChildren();
                const matches = estados.filter(value => normalizeText(value).includes(normalizeText(estadoBusqueda.value)));
                matches.forEach((value, index) => {
                  const option = document.createElement('div');
                  option.id = `estado-opcion-${index}`;
                  option.setAttribute('role', 'option');
                  option.setAttribute('aria-selected', String(value === estadoSelect.value));
                  option.className = 'px-3 py-2';
                  option.style.cursor = 'pointer';
                  option.textContent = value;
                  option.addEventListener('mousedown', event => event.preventDefault());
                  option.addEventListener('click', () => seleccionarEstado(value));
                  estadoOpciones.appendChild(option);
                });
                if (!matches.length) {
                  const empty = document.createElement('div');
                  empty.className = 'px-3 py-2 text-muted';
                  empty.textContent = 'Sin coincidencias';
                  estadoOpciones.appendChild(empty);
                }
                estadoOpciones.hidden = false;
                estadoBusqueda.setAttribute('aria-expanded', 'true');
              };
              estadoBusqueda.addEventListener('input', () => {
                estadoSelect.value = '';
                estadoBusqueda.setCustomValidity('Selecciona un estado de la lista.');
                estadoSelect.dispatchEvent(new Event('change'));
                filtrarEstados();
              });
              estadoBusqueda.addEventListener('focus', filtrarEstados);
              estadoBusqueda.addEventListener('click', filtrarEstados);
              estadoBusqueda.addEventListener('blur', cerrarEstados);
              estadoBusqueda.addEventListener('keydown', event => {
                if (event.key === 'Escape' || event.key === 'Tab') { cerrarEstados(); return; }
                if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                  event.preventDefault();
                  if (estadoOpciones.hidden) filtrarEstados();
                  const options = [...estadoOpciones.querySelectorAll('[role="option"]')];
                  if (!options.length) return;
                  estadoActiveIndex = Math.max(0, Math.min(options.length - 1, estadoActiveIndex + (event.key === 'ArrowDown' ? 1 : -1)));
                  options.forEach((option, index) => option.classList.toggle('bg-light', index === estadoActiveIndex));
                  estadoBusqueda.setAttribute('aria-activedescendant', options[estadoActiveIndex].id);
                  options[estadoActiveIndex].scrollIntoView({ block: 'nearest' });
                } else if (event.key === 'Enter' && !estadoOpciones.hidden) {
                  event.preventDefault();
                  const option = estadoOpciones.querySelectorAll('[role="option"]')[estadoActiveIndex];
                  if (option) seleccionarEstado(option.textContent);
                }
              });

              const filtrarLocalidades = () => {
                const matches = localidades.filter(value => normalizeText(value).includes(normalizeText(localidadBusqueda.value)));
                activeIndex = -1;
                localidadBusqueda.removeAttribute('aria-activedescendant');
                localidadOpciones.replaceChildren();
                matches.forEach((value, index) => {
                  const option = document.createElement('div');
                  option.id = `localidad-opcion-${index}`;
                  option.dataset.value = value;
                  option.setAttribute('role', 'option');
                  option.setAttribute('aria-selected', String(value === selectedLocalidad));
                  option.className = 'px-3 py-2';
                  option.style.cursor = 'pointer';
                  option.textContent = value;
                  option.addEventListener('mousedown', event => event.preventDefault());
                  option.textContent = capitalizarLocalidad(value);
                  option.addEventListener('click', () => seleccionarLocalidad(value));
                  localidadOpciones.appendChild(option);
                });
                if (!matches.length) {
                  const empty = document.createElement('div');
                  empty.className = 'px-3 py-2 text-muted';
                  empty.textContent = 'Sin coincidencias';
                  localidadOpciones.appendChild(empty);
                }
                localidadOpciones.hidden = false;
                localidadBusqueda.setAttribute('aria-expanded', 'true');
                localidadEstado.textContent = matches.length ? 'Selecciona una opción de la lista para registrarla.' : 'No hay localidades que coincidan con la búsqueda.';
              };
              const capitalizarLocalidad = value => String(value).toLocaleLowerCase('es-MX')
                .replace(/(^|\s)(\p{L})/gu, (_, space, letter) => space + letter.toLocaleUpperCase('es-MX'));
              const seleccionarLocalidad = value => {
                selectedLocalidad = value;
                ciudadSelect.value = value;
                localidadBusqueda.value = capitalizarLocalidad(value);
                localidadBusqueda.setCustomValidity('');
                localidadEstado.textContent = 'Localidad seleccionada.';
                cerrarLocalidades();
              };
              localidadBusqueda.addEventListener('input', () => {
                selectedLocalidad = '';
                ciudadSelect.value = '';
                localidadBusqueda.setCustomValidity('Selecciona una localidad de la lista.');
                filtrarLocalidades();
              });
              localidadBusqueda.addEventListener('focus', filtrarLocalidades);
              localidadBusqueda.addEventListener('click', filtrarLocalidades);
              localidadBusqueda.addEventListener('blur', cerrarLocalidades);
              localidadBusqueda.addEventListener('keydown', event => {
                if (event.key === 'Escape' || event.key === 'Tab') { cerrarLocalidades(); return; }
                if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                  event.preventDefault();
                  if (localidadOpciones.hidden) filtrarLocalidades();
                  const options = [...localidadOpciones.querySelectorAll('[role="option"]')];
                  if (!options.length) return;
                  activeIndex = Math.max(0, Math.min(options.length - 1, activeIndex + (event.key === 'ArrowDown' ? 1 : -1)));
                  options.forEach((option, index) => option.classList.toggle('bg-light', index === activeIndex));
                  localidadBusqueda.setAttribute('aria-activedescendant', options[activeIndex].id);
                  options[activeIndex].scrollIntoView({ block: 'nearest' });
                } else if (event.key === 'Enter' && !localidadOpciones.hidden) {
                  event.preventDefault();
                  const option = localidadOpciones.querySelectorAll('[role="option"]')[activeIndex];
                  if (option) seleccionarLocalidad(option.dataset.value);
                }
              });
              ciudadSelect.form.addEventListener('submit', event => {
                if (!estadoSelect.value || ciudadSelect.disabled || !ciudadSelect.value) {
                  event.preventDefault();
                  localidadEstado.textContent = 'Selecciona un estado y una ciudad o localidad de la lista.';
                }
              });

              estadoSelect.addEventListener('change', async () => {
                const version = ++requestVersion;
                const selectedState = estados.find((estado) => normalizeText(estado) === normalizeText(estadoSelect.value));
                localidades = [];
                selectedLocalidad = '';
                cerrarLocalidades();
                ciudadSelect.replaceChildren(new Option('Selecciona primero un estado', ''));
                localidadBusqueda.value = '';
                localidadBusqueda.setCustomValidity('Selecciona una localidad de la lista.');
                localidadBusqueda.disabled = true;
                ciudadSelect.disabled = true;
                if (!selectedState) {
                  localidadEstado.textContent = 'Selecciona primero un estado de la lista.';
                  return;
                }
                localidadEstado.textContent = 'Cargando localidades…';
                try {
                  const response = await fetch(`/api/localidades?estado=${encodeURIComponent(selectedState)}`);
                  if (!response.ok) throw new Error('No se pudieron cargar las localidades');
                  const data = await response.json();
                  if (version !== requestVersion) return;
                  localidades = data.localidades || [];
                  estadoSelect.value = selectedState;
                  localidades.forEach(value => ciudadSelect.appendChild(new Option(value, value)));
                  localidadEstado.textContent = localidades.length ? 'Busca y selecciona una opción de la lista.' : 'No hay localidades para este estado.';
                  ciudadSelect.disabled = localidades.length === 0;
                  localidadBusqueda.disabled = localidades.length === 0;
                } catch {
                  if (version === requestVersion) localidadEstado.textContent = 'No se pudieron cargar las localidades. Vuelve a seleccionar el estado.';
                }
              });

              loadStates().catch(() => {
                estadoBusqueda.placeholder = 'No fue posible cargar los estados';
              });
            </script>
          </div>
        </div>

        <% } %>

        <div class="<%= typeof currentUser !== 'undefined' && currentUser.role === 'uecs' ? 'col-md-12' : 'col-md-8' %> py-3 custom_table">
          <h3 class="text-center">Lista de ubicaciones</h3>
          <hr />

          <div class="mb-3 d-flex justify-content-end">
            <form id="ubicacionesSearchForm" class="d-flex align-items-center" action="/ubicaciones" method="GET">
              <input type="hidden" name="pageSize" value="<%= pageSize || 10 %>" />
              <input type="hidden" name="page" value="1" />
              <input
                type="text"
                id="ubicacionesSearch"
                name="search"
                class="form-control form-control-sm"
                placeholder="Buscar coordenadas (lat,long), ubicación o lugar"
                value="<%= searchTerm || '' %>"
                class="form-control form-control-sm ubicaciones-search-input"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />
            </form>
          </div>

          <div id="ubicacionesResultsContainer">
            <%- include('../partials/ubicaciones-results') %>
          </div>

          <script>
            document.getElementById('pageSizeControl')?.addEventListener('change', function() {
              const pageInput = document.querySelector('#pageSizeForm input[name="page"]');
              if (pageInput) {
                pageInput.value = '1';
              }
              this.form.submit();
            });
          </script>

          <script>
            const ubicacionesSearchInput = document.getElementById('ubicacionesSearch');
            const ubicacionesSearchForm = document.getElementById('ubicacionesSearchForm');
            const ubicacionesResultsContainer = document.getElementById('ubicacionesResultsContainer');

            const loadUbicacionesResults = async (searchValue = '', page = 1) => {
              if (!ubicacionesResultsContainer || !ubicacionesSearchInput) return;

              const params = new URLSearchParams({
                search: searchValue,
                page,
                pageSize: document.querySelector('#pageSizeForm select[name="pageSize"]')?.value || '<%= pageSize || 10 %>',
                fragment: '1',
              });

              try {
                const response = await fetch(`/ubicaciones?${params.toString()}`);
                const html = await response.text();
                if (response.ok) {
                  ubicacionesResultsContainer.innerHTML = html;
                  attachUbicacionesResultHandlers();
                }
              } catch (error) {
                console.error('Ubicaciones search failed:', error);
              }
            };

            const attachUbicacionesResultHandlers = () => {
              if (!ubicacionesResultsContainer) return;

              if (ubicacionesResultsContainer._handlersAttached) return;
              ubicacionesResultsContainer._handlersAttached = true;

              ubicacionesResultsContainer.addEventListener('click', (e) => {
                const a = e.target.closest('.page-link');
                if (!a) return;
                const page = a.getAttribute('data-page');
                if (!page) return;
                e.preventDefault();
                loadUbicacionesResults(ubicacionesSearchInput.value || '', Number(page));
              });

              ubicacionesResultsContainer.addEventListener('change', (e) => {
                const target = e.target;
                if (target && target.id === 'pageSizeControl') {
                  loadUbicacionesResults(ubicacionesSearchInput.value || '', 1);
                }
              });
            };

            if (ubicacionesSearchInput && ubicacionesSearchForm) {
              let searchTimer;

              ubicacionesSearchInput.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                  this.value = '';
                  loadUbicacionesResults(this.value, 1);
                }
              });

              ubicacionesSearchInput.addEventListener('input', function() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => {
                  loadUbicacionesResults(this.value, 1);
                }, 250);
              });

              ubicacionesSearchForm.addEventListener('submit', function(event) {
                event.preventDefault();
                loadUbicacionesResults(ubicacionesSearchInput.value, 1);
              });
            }

            window.addEventListener('load', () => {
              loadUbicacionesResults(ubicacionesSearchInput?.value || '', 1);
            });
          </script>
        </div>
      </div>
    </div>

    <script>
      const mapContainer = document.getElementById('map');
      const coordinatesInput = document.getElementById('coordinates');
      const defaultCenter = { lat: 19.432608, lng: -99.133209 };
      let mapInstance = null;
      let markerInstance = null;

      const showMapUnavailable = (message = 'Configura GOOGLE_MAPS_API_KEY para ver el mapa.') => {
        if (mapContainer) {
          mapContainer.innerHTML = `<div class="d-flex align-items-center justify-content-center h-100 text-muted location-map-message">${message}</div>`;
        }
      };

      const parseCoordinateValue = (value) => {
        const normalizedValue = String(value || '').trim();
        if (!normalizedValue) {
          return null;
        }

        const numericValue = Number(normalizedValue);
        if (!Number.isNaN(numericValue) && String(numericValue) === normalizedValue.replace(/^[+]/, '')) {
          return numericValue;
        }

        const dmsMatch = normalizedValue.match(/^(\d{1,3})\s*[°º]\s*(\d{1,2})\s*['’]\s*(\d{1,2}(?:\.\d+)?)\s*["″]?\s*([NSEW])$/i);
        if (!dmsMatch) {
          return null;
        }

        let decimalValue = Number(dmsMatch[1]) + Number(dmsMatch[2]) / 60 + Number(dmsMatch[3]) / 3600;
        const hemisphere = dmsMatch[4].toUpperCase();
        if (hemisphere === 'S' || hemisphere === 'W') {
          decimalValue = -decimalValue;
        }

        return decimalValue;
      };

      const parseCoordinates = (value) => {
        if (!value) {
          return null;
        }

        const cleanedValue = String(value).trim();
        const parts = cleanedValue.split(/[\s,;]+/).filter(Boolean);
        if (parts.length !== 2) {
          return null;
        }

        const latitude = parseCoordinateValue(parts[0]);
        const longitude = parseCoordinateValue(parts[1]);
        if (latitude === null || longitude === null) {
          return null;
        }

        return { lat: latitude, lng: longitude };
      };

      const updateMapFromInput = (map, marker) => {
        const parsed = parseCoordinates(coordinatesInput?.value || '');
        if (!parsed) {
          return;
        }

        map.setCenter(parsed);
        marker.setPosition(parsed);
        marker.setVisible(true);
      };

      let heatmapInstance = null;

      const loadHeatmap = async () => {
        if (!mapInstance || typeof google === 'undefined' || !google.maps || !google.maps.visualization) {
          return;
        }

        try {
          const response = await fetch('/api/ubicaciones/heatmap');
          if (!response.ok) {
            throw new Error('No se pudieron cargar las ubicaciones para el mapa de calor.');
          }

          const { points } = await response.json();
          if (!Array.isArray(points) || points.length === 0) {
            if (heatmapInstance) {
              heatmapInstance.setMap(null);
              heatmapInstance = null;
            }
            return;
          }

          const weightedData = points.map(({ lat, lng, weight }) => ({
            location: new google.maps.LatLng(lat, lng),
            weight: Math.max(1, Math.min(Number(weight) || 1, 10)),
          }));

          if (!heatmapInstance) {
            heatmapInstance = new google.maps.visualization.HeatmapLayer({
              data: weightedData,
              radius: 26,
              opacity: 0.85,
              maxIntensity: 10,
              dissipating: true,
            });
            heatmapInstance.setMap(mapInstance);
            return;
          }

          heatmapInstance.setData(weightedData);
          heatmapInstance.setMap(mapInstance);
        } catch (error) {
          console.warn('Heatmap unavailable:', error);
        }
      };

      const focusLocationOnMap = (latitude, longitude) => {
        if (!mapInstance || !markerInstance) {
          return;
        }

        const parsed = parseCoordinates(`${latitude}, ${longitude}`);
        if (!parsed) {
          return;
        }

        coordinatesInput.value = `${parsed.lat.toFixed(6)}, ${parsed.lng.toFixed(6)}`;
        mapInstance.setCenter(parsed);
        markerInstance.setPosition(parsed);
        markerInstance.setVisible(true);
      };

      window.initMap = function () {
        if (!mapContainer || !coordinatesInput) {
          return;
        }

        const initialPosition = parseCoordinates(coordinatesInput.value) || defaultCenter;
        mapInstance = new google.maps.Map(mapContainer, {
          center: initialPosition,
          zoom: 12,
          streetViewControl: false,
        });

        markerInstance = new google.maps.Marker({
          position: initialPosition,
          map: mapInstance,
          draggable: true,
        });

        mapInstance.addListener('click', (event) => {
          const clickedPosition = {
            lat: event.latLng.lat(),
            lng: event.latLng.lng(),
          };

          markerInstance.setPosition(clickedPosition);
          markerInstance.setVisible(true);
          coordinatesInput.value = `${clickedPosition.lat.toFixed(6)}, ${clickedPosition.lng.toFixed(6)}`;
        });

        markerInstance.addListener('dragend', (event) => {
          const draggedPosition = {
            lat: event.latLng.lat(),
            lng: event.latLng.lng(),
          };
          coordinatesInput.value = `${draggedPosition.lat.toFixed(6)}, ${draggedPosition.lng.toFixed(6)}`;
        });

        loadHeatmap();

        coordinatesInput.addEventListener('change', () => {
          updateMapFromInput(mapInstance, markerInstance);
        });

        coordinatesInput.addEventListener('blur', () => {
          updateMapFromInput(mapInstance, markerInstance);
        });
      };

      window.gm_authFailure = function () {
        showMapUnavailable('La clave de Google Maps no es válida o no tiene habilitada la API de Maps JavaScript.');
      };

      if (typeof google === 'undefined' || !google.maps) {
        showMapUnavailable();
      }

      async function copyTextToClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch (error) {
            console.warn('Clipboard API unavailable, using fallback.', error);
          }
        }

        const temporaryInput = document.createElement('textarea');
        temporaryInput.value = text;
        temporaryInput.setAttribute('readonly', '');
        temporaryInput.style.position = 'fixed';
        temporaryInput.style.opacity = '0';
        temporaryInput.style.pointerEvents = 'none';
        document.body.appendChild(temporaryInput);
        temporaryInput.select();
        temporaryInput.setSelectionRange(0, temporaryInput.value.length);

        const copied = document.execCommand('copy');
        document.body.removeChild(temporaryInput);
        return copied;
      }

      async function copyLocationToClipboard(ubicacion, lugar) {
        const text = buildClipboardText([ubicacion, lugar]);

        // Incluir una tabla HTML hace que Excel y otras hojas de cálculo
        // reconozcan ambos valores como columnas independientes al pegar.
        if (navigator.clipboard && window.isSecureContext && window.ClipboardItem) {
          const table = document.createElement('table');
          const row = table.insertRow();
          [ubicacion, lugar].forEach((value) => {
            const cell = row.insertCell();
            // Excel respeta este estilo al pegar el contenido HTML.
            cell.style.whiteSpace = 'nowrap';
            cell.style.setProperty('mso-wrap-style', 'none');
            cell.textContent = value;
          });

          try {
            await navigator.clipboard.write([
              new ClipboardItem({
                'text/plain': new Blob([text], { type: 'text/plain' }),
                'text/html': new Blob([table.outerHTML], { type: 'text/html' }),
              }),
            ]);
            return true;
          } catch (error) {
            console.warn('Rich clipboard copy unavailable, using text fallback.', error);
          }
        }

        return copyTextToClipboard(text);
      }

      document.addEventListener('click', async function(event) {
        if (event.target.closest('.edit-location-btn')) return;
        const button = event.target.closest('.copy-location-btn');
        if (button) {
          event.preventDefault();
          const ubicacion = button.getAttribute('data-ubicacion') || '';
          const lugar = button.getAttribute('data-lugar') || '';

          try {
            const copied = await copyLocationToClipboard(ubicacion, lugar);
            if (!copied) throw new Error('Copy command was rejected.');
            button.textContent = 'Copiado';
            setTimeout(() => {
              button.textContent = 'Copiar';
            }, 1500);
          } catch (error) {
            console.error('Unable to copy location details:', error);
            window.noticeToast('No se pudo copiar al portapapeles.');
          }
          return;
        }

        const row = event.target.closest('.location-row');
        if (!row) return;

        const latitude = row.getAttribute('data-latitude') || '';
        const longitude = row.getAttribute('data-longitude') || '';
        focusLocationOnMap(latitude, longitude);
      });

      document.addEventListener('keydown', function(event) {
        if ((event.key === 'Enter' || event.key === ' ') && event.target.classList.contains('location-row')) {
          event.preventDefault();
          const latitude = event.target.getAttribute('data-latitude') || '';
          const longitude = event.target.getAttribute('data-longitude') || '';
          focusLocationOnMap(latitude, longitude);
        }
      });
    </script>
    <% if (googleMapsApiKey) { %>
    <script>
      const googleMapsScript = document.createElement('script');
      googleMapsScript.src = 'https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&libraries=visualization&callback=initMap';
      googleMapsScript.async = true;
      googleMapsScript.defer = true;
      googleMapsScript.onerror = function () {
        showMapUnavailable('No se pudo cargar Google Maps. Revisa la clave o la habilitación de la API.');
      };
      document.body.appendChild(googleMapsScript);
    </script>
    <% } else { %>
    <script>
      showMapUnavailable();
    </script>
    <% } %>
    <%- include('../includes/scripts') %>
    <%- include('../includes/footer') %>
  </body>
</html>
