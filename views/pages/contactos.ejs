<div class="<%= typeof currentUser !== 'undefined' && currentUser.role === 'uecs' ? 'col-md-12' : 'col-md-8' %> py-3 custom_table">
  <h3 class="text-center">
    Lista de Contactos
    <hr />
  </h3>

  <div class="mb-3 d-flex justify-content-end">
    <form id="contactosSearchForm" class="d-flex align-items-center" action="/Crud" method="GET">
      <input type="hidden" name="pageSize" value="<%= typeof pageSize !== 'undefined' ? pageSize : 10 %>" />
      <input type="hidden" name="page" value="1" />
      <input
        type="text"
        id="contactosSearch"
        name="numObjetivo"
        class="form-control form-control-sm"
        placeholder="Buscar objetivo, contacto, NUC, año o tipo"
        value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>"
        class="form-control form-control-sm contactos-search-input"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
      />
    </form>
  </div>

  <div id="contactosResultsContainer">
    <%- include('../partials/contactos-results') %>
  </div>
</div>
