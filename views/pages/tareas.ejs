<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
    <link rel="stylesheet" href="/public/css/tareas.css" />
  </head>
  <body>
    <%- include('../includes/header') %>
    <% const yo = typeof currentUser !== 'undefined' && currentUser ? String(currentUser.id) : ''; %>
    <main class="container-fluid px-3 px-xl-4 page-offset tareas-page">
      <div class="row justify-content-md-center mb-4">
        <div class="col-md-12 mt-5">
          <h1 class="text-center title">TAREAS</h1>
          <hr />
        </div>
      </div>

      <% if (message) { %>
        <div class="alert <%= messageType === 'error' ? 'alert-danger' : 'alert-success' %>" role="<%= messageType === 'error' ? 'alert' : 'status' %>"><%= message %></div>
        <script>
          // The message travels in the URL; drop it so reloading or going back does not show it again.
          (() => {
            const url = new URL(location.href);
            url.searchParams.delete('message');
            url.searchParams.delete('type');
            history.replaceState(null, '', url);
          })();
        </script>
      <% } %>

      <details class="card p-3 tareas-nueva"<%= formError ? ' open' : '' %>>
        <summary><i class="bi bi-plus-lg" aria-hidden="true"></i> Nueva tarea</summary>
        <% if (formError) { %><div class="alert alert-danger mt-2" role="alert" id="tareaFormError"><%= formError.message %></div><% } %>
        <% const invalid = (field) => (formError?.field === field ? ' is-invalid" aria-invalid="true" aria-describedby="tareaFormError' : ''); %>
        <form action="/tareas" method="POST" autocomplete="off" class="row g-3 mt-1">
          <input type="hidden" name="volver" value="<%= filtro %>" />
          <div class="col-lg-6">
            <label for="titulo" class="form-label">Título <span class="text-danger" aria-hidden="true">*</span></label>
            <input type="text" id="titulo" name="titulo" class="form-control<%- invalid('titulo') %>" maxlength="200" required value="<%= form.titulo || '' %>" />
          </div>
          <%- include('../partials/tarea-asignacion', { form, opciones, puestoLabels, invalid, columnClass: 'col-md-6 col-lg-3' }) %>
          <div class="col-lg-6">
            <label for="descripcion" class="form-label">Descripción</label>
            <textarea id="descripcion" name="descripcion" class="form-control<%- invalid('descripcion') %>" rows="2" maxlength="2000"><%= form.descripcion || '' %></textarea>
          </div>
          <div class="col-md-6 col-lg-3">
            <label for="fechaLlegada" class="form-label">Fecha de llegada <span class="text-danger" aria-hidden="true">*</span></label>
            <input type="date" id="fechaLlegada" name="fechaLlegada" class="form-control<%- invalid('fechaLlegada') %>" required max="<%= hoy %>"
              value="<%= form.fechaLlegada || '' %>" aria-describedby="fechaLlegadaAyuda" />
            <div id="fechaLlegadaAyuda" class="form-text">No se puede cambiar después.</div>
          </div>
          <div class="col-md-6 col-lg-3">
            <label for="estado" class="form-label">Columna</label>
            <select id="estado" name="estado" class="form-select">
              <% ESTADOS.forEach((estado) => { %>
                <option value="<%= estado %>"<%= form.estado === estado ? ' selected' : '' %>><%= ESTADO_LABELS[estado] %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <button class="btn btn-primary" type="submit">Registrar tarea</button>
          </div>
        </form>
      </details>

      <form class="tareas-barra" action="/tareas" method="GET">
        <label for="filtroResponsable" class="form-label fw-semibold">Ver tareas de</label>
        <select id="filtroResponsable" name="responsable" class="form-select" onchange="this.form.submit()">
          <option value="">Todos</option>
          <% if (yo) { %><option value="<%= yo %>"<%= filtro === yo ? ' selected' : '' %>>Mis tareas</option><% } %>
          <option value="sin"<%= filtro === 'sin' ? ' selected' : '' %>>Sin asignar</option>
          <% responsables.filter((user) => String(user.id) !== yo).forEach((user) => { %>
            <option value="<%= user.id %>"<%= filtro === String(user.id) ? ' selected' : '' %>><%= user.email %></option>
          <% }) %>
        </select>
        <noscript><button class="btn btn-outline-secondary" type="submit">Filtrar</button></noscript>
        <%# Search and label filters act on the cards already on screen, as you type or click (tareas.js). %>
        <div class="tareas-buscar" hidden data-solo-js>
          <i class="bi bi-search" aria-hidden="true"></i>
          <label for="tareasBuscar" class="visually-hidden">Buscar tarjetas</label>
          <input type="search" id="tareasBuscar" class="form-control" placeholder="Buscar tarjetas" autocomplete="off" />
        </div>
        <a class="btn btn-outline-secondary ms-auto" href="/tareas/archivo"><i class="bi bi-archive" aria-hidden="true"></i> Archivo</a>
      </form>
      <% if (etiquetas.length) { %>
        <div class="tareas-filtro-etiquetas" role="group" aria-label="Filtrar por etiqueta" hidden data-solo-js>
          <span class="small fw-semibold">Etiquetas:</span>
          <% etiquetas.forEach((etiqueta) => { %>
            <button type="button" class="tarea-etiqueta etiqueta-<%= etiqueta.color %> tareas-filtro-etiqueta" data-etiqueta="<%= etiqueta.id %>" aria-pressed="false"><%= etiqueta.nombre %></button>
          <% }) %>
        </div>
      <% } %>
      <p class="tareas-sin-resultados small text-muted" role="status" hidden>Ninguna tarjeta coincide con la búsqueda.</p>

      <div class="tareas-tablero" data-filtro="<%= filtro %>" data-abrir="<%= abrir %>">
        <%- include('../partials/tareas-tablero') %>
      </div>
    </main>
    <%# The window a card opens in; tareas.js fills it with the task's details. %>
    <dialog class="tarea-modal" aria-labelledby="tareaModalTitulo">
      <h2 id="tareaModalTitulo" class="visually-hidden">Detalle de la tarea</h2>
      <div class="tarea-modal-contenido"></div>
    </dialog>
    <%- include('../includes/scripts') %>
    <script src="/public/js/tareas.js" defer></script>
    <%- include('../includes/footer') %>
  </body>
</html>
