<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
      .metrics-page {
        --ink: #18324b;
        --muted: #66788a;
        --line: #dce7ed;
        --surface: #fff;
        --track: #edf3f5;
        --teal: #087f8c;
        --orange: #ed7d3a;
        --blue: #3273a8;
        --green: #3f9435;
        --pink: #b35c92;
        --olive: #8d7a3b;
        --pending: #f0a35b;
        --warning: #c2410c;
        padding-bottom: 3rem;
      }

      html[data-theme="dark"] .metrics-page {
        --surface: var(--dark-panel);
        --track: #2b394c;
        --teal: #3fb8c4;
        --orange: #f29a63;
        --blue: #6ea8dc;
        --green: #6cc25f;
        --pink: #d98bbb;
        --olive: #c9b56c;
        --pending: #f5b97a;
        --warning: #fb923c;
      }

      .metrics-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .metrics-header p {
        max-width: 560px;
        color: var(--muted);
        margin: 0;
      }

      .metric-card,
      .chart-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: 0 12px 28px rgba(24, 50, 75, .07);
      }

      .metric-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.15rem;
        border-top: 4px solid var(--accent, var(--teal));
        color: inherit;
        text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
      }

      .metric-card:hover,
      .metric-card:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 16px 32px rgba(24, 50, 75, .12);
        color: inherit;
      }

      .metric-label {
        color: var(--muted);
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
      }

      .metric-value {
        color: var(--ink);
        font-size: 2.15rem;
        font-weight: 800;
        line-height: 1;
        margin-top: .55rem;
      }

      .metric-hint {
        color: var(--muted);
        font-size: .78rem;
        margin-top: .45rem;
      }

      .chart-panel {
        height: 100%;
        padding: 1.35rem;
      }

      .chart-panel h3 {
        color: var(--ink);
        font-size: 1.05rem;
        margin: 0 0 .25rem;
      }

      .chart-caption {
        color: var(--muted);
        font-size: .86rem;
        margin-bottom: 1.35rem;
      }

      .chart-empty {
        color: var(--muted);
        font-size: .9rem;
        padding: 1.5rem 0;
        text-align: center;
      }

      .trend-summary {
        display: flex;
        gap: 2rem;
        margin-bottom: 1rem;
      }

      .trend-summary strong {
        display: block;
        color: var(--ink);
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.1;
      }

      .trend-summary span {
        color: var(--muted);
        font-size: .8rem;
      }

      .trend-chart {
        display: flex;
        align-items: end;
        gap: 3px;
        height: 150px;
        border-bottom: 1px solid var(--line);
      }

      .trend-bar {
        display: flex;
        flex: 1;
        align-items: end;
        height: 100%;
      }

      .trend-bar span {
        width: 100%;
        background: var(--teal);
        border-radius: 3px 3px 0 0;
      }

      .trend-bar:hover span { background: var(--blue); }

      .trend-axis {
        display: flex;
        justify-content: space-between;
        color: var(--muted);
        font-size: .75rem;
        margin-top: .4rem;
      }

      .bar-chart {
        display: grid;
        gap: .85rem;
      }

      .bar-row {
        display: grid;
        grid-template-columns: 140px 1fr 56px;
        align-items: center;
        gap: .7rem;
      }

      .bar-label,
      .bar-number {
        overflow: hidden;
        color: var(--ink);
        font-size: .86rem;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      a.bar-label:hover { text-decoration: underline; }

      .bar-row.is-other .bar-label { color: var(--muted); font-style: italic; }

      .bar-number { text-align: right; }

      .bar-track {
        height: 14px;
        overflow: hidden;
        background: var(--track);
        border-radius: 3px;
      }

      .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--teal), #35b6ac);
        border-radius: inherit;
      }

      .status-chart {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        min-height: 190px;
      }

      .donut {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 150px;
        height: 150px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: conic-gradient(var(--green) var(--completion, 0%), var(--pending) 0);
      }

      .donut::before {
        position: absolute;
        inset: 29px;
        content: '';
        background: var(--surface);
        border-radius: 50%;
      }

      .donut-value,
      .donut-label { position: relative; }
      .donut-value { color: var(--ink); font-size: 1.5rem; font-weight: 800; line-height: 1; }
      .donut-label { color: var(--muted); font-size: .72rem; }

      .legend { display: grid; gap: .8rem; }
      .legend-item { display: flex; align-items: center; gap: .55rem; color: var(--ink); font-size: .9rem; text-decoration: none; }
      .legend-link:hover { color: var(--ink); text-decoration: underline; }
      .legend-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--green); }
      .legend-dot.pending { background: var(--pending); }
      .legend strong { margin-left: auto; padding-left: 1.25rem; }

      .quality-list {
        display: grid;
        gap: .2rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .quality-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .6rem 0;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        font-size: .9rem;
      }

      .quality-item:last-child { border-bottom: 0; }
      .quality-item a { color: var(--ink); }
      .quality-item strong { margin-left: auto; white-space: nowrap; }
      .quality-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--green); }
      .quality-item.is-warning .quality-dot { background: var(--warning); }
      .quality-item.is-warning strong { color: var(--warning); }
      .quality-item.is-ok strong { color: var(--muted); font-weight: 600; }

      .refresh-button {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
      }

      .refresh-icon { display: inline-block; }
      .refresh-icon.spinning { animation: refresh-spin 1s linear infinite; }

      @keyframes refresh-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .last-updated {
        color: var(--muted);
        font-size: .78rem;
      }

      .geocoding-panel {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: auto;
      }

      .geocoding-info { flex: 1 1 320px; }
      .geocoding-panel.is-blocked { border-color: var(--warning); }
      .bar-fill.is-high { background: var(--warning); }

      .heatmap-panel {
        margin-top: 1.5rem;
      }

      .heatmap-map {
        width: 100%;
        height: min(70vh, 560px);
        min-height: 320px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--track);
        overflow: hidden;
      }

      .heatmap-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: var(--muted);
        text-align: center;
        font-size: .95rem;
        padding: 1rem;
      }

      @media (prefers-reduced-motion: reduce) {
        .metric-card { transition: none; }
        .refresh-icon.spinning { animation: none; }
      }

      @media (max-width: 700px) {
        .metrics-header { display: block; }
        .metrics-header p { margin: .5rem 0 .75rem; }
        .bar-row { grid-template-columns: 100px 1fr 48px; gap: .45rem; }
        .status-chart { flex-direction: column; gap: 1.25rem; }
        .legend { width: min(100%, 230px); }
        .metric-value { font-size: 1.75rem; }
      }
    </style>
  </head>
  <body>
    <%- include('../includes/header') %>

    <main class="content-wrapper mt-5 metrics-page page-offset">
      <div class="container py-4 metrics-container">
        <div class="metrics-header">
          <div>
            <h2 class="title mb-1">Medidores del sistema</h2>
            <p>Resumen de los registros administrados en la plataforma. Se actualiza sola cada 2 minutos mientras la usas.</p>
          </div>
          <div class="d-flex align-items-center flex-wrap gap-2">
            <span id="lastUpdated" class="last-updated" aria-live="polite"></span>
            <button id="refreshButton" type="button" class="btn btn-sm btn-outline-secondary refresh-button">
              <span class="refresh-icon" aria-hidden="true">⟳</span>
              Actualizar
            </button>
            <span class="badge text-bg-light border">Solo administradores</span>
          </div>
        </div>

        <% if (locals.message) { %><div class="alert alert-success"><%= message %></div><% } %>
        <% if (locals.error) { %><div class="alert alert-danger"><%= error %></div><% } %>

        <div id="medidoresResumen">
          <%- include('../partials/medidores-resumen') %>
        </div>

        <article class="chart-panel heatmap-panel">
          <h3>Densidad de antenas</h3>
          <div class="chart-caption">Mapa de calor con ubicaciones registradas y concentración por zona.</div>
          <div id="medidoresHeatmapMap" class="heatmap-map" data-carto-key="<%= cartoApiKey %>" aria-label="Mapa de calor de antenas"></div>
        </article>
      </div>
    </main>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <script>
      (() => {
        const REFRESH_MS = 2 * 60 * 1000;
        const resumen = document.getElementById('medidoresResumen');
        const refreshButton = document.getElementById('refreshButton');
        const refreshIcon = refreshButton?.querySelector('.refresh-icon');
        const lastUpdated = document.getElementById('lastUpdated');
        let lastRefresh = Date.now();
        let loading = false;

        const markUpdated = () => {
          lastRefresh = Date.now();
          const time = new Date(lastRefresh).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
          lastUpdated.textContent = `Actualizado a las ${time}`;
        };

        const refresh = async () => {
          if (loading || !resumen) return;
          loading = true;
          refreshButton.disabled = true;
          refreshIcon?.classList.add('spinning');
          try {
            const response = await fetch('/medidores/resumen', { credentials: 'same-origin' });
            // An expired session redirects to the login page; reload so the user sees it.
            if (response.redirected) return window.location.reload();
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            resumen.innerHTML = await response.text();
            markUpdated();
          } catch (error) {
            console.warn('Medidores refresh failed:', error);
            lastUpdated.textContent = 'No se pudo actualizar; se reintentará.';
          } finally {
            loading = false;
            refreshButton.disabled = false;
            refreshIcon?.classList.remove('spinning');
          }
        };

        // Every request renews the server session, so an unattended tab must stop polling
        // and let the session expire as usual.
        const ACTIVE_MS = 5 * 60 * 1000;
        let lastInteraction = Date.now();
        ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach((eventName) => {
          document.addEventListener(eventName, () => { lastInteraction = Date.now(); }, { passive: true });
        });
        const shouldAutoRefresh = () => document.visibilityState === 'visible' && Date.now() - lastInteraction < ACTIVE_MS;

        markUpdated();
        refreshButton?.addEventListener('click', refresh);
        // Hidden tabs skip refreshes; catch up as soon as the tab is visible again.
        setInterval(() => {
          if (shouldAutoRefresh()) refresh();
        }, REFRESH_MS);
        document.addEventListener('visibilitychange', () => {
          if (shouldAutoRefresh() && Date.now() - lastRefresh >= REFRESH_MS) refresh();
        });
      })();

      (() => {
        const mapElement = document.getElementById('medidoresHeatmapMap');
        if (!mapElement) return;

        const showMessage = (message) => {
          mapElement.innerHTML = `<div class="heatmap-empty">${message}</div>`;
        };

        if (typeof L === 'undefined' || typeof L.heatLayer !== 'function') {
          showMessage('No fue posible cargar la librería del mapa de calor.');
          return;
        }

        const cartoKey = mapElement.dataset.cartoKey;
        // CARTO Voyager: roads drawn in color with legible street names. The paler Positron and Dark Matter
        // styles made it hard to tell which street a hot spot sits on. There is no dark Voyager, so it is
        // used in both themes.
        const tileUrl = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png'
          + (cartoKey ? `?key=${encodeURIComponent(cartoKey)}` : '');

        fetch('/api/ubicaciones/heatmap')
          .then((response) => {
            if (!response.ok) throw new Error('No se pudieron cargar las ubicaciones.');
            return response.json();
          })
          .then(({ points }) => {
            if (!Array.isArray(points) || points.length === 0) {
              showMessage('Aún no hay ubicaciones registradas para mostrar el mapa de calor.');
              return;
            }

            const map = L.map(mapElement, { zoomControl: true, attributionControl: true }).setView([23.6345, -102.5528], 5);
            L.tileLayer(tileUrl, {
              attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
              maxZoom: 19,
            }).addTo(map);

            L.heatLayer(points.map(({ lat, lng, weight }) => [lat, lng, Math.min(Math.max(Number(weight) || 1, 1), 12)]), {
              radius: 22,
              blur: 16,
              maxZoom: 12,
              // No yellow or orange: Voyager draws main roads in those colors.
              gradient: { 0.1: '#5ac8fa', 0.4: '#3b6fd6', 0.7: '#c2369b', 1.0: '#e3172e' },
            }).addTo(map);

            const bounds = L.latLngBounds(points.map(({ lat, lng }) => [lat, lng]));
            if (bounds.isValid()) map.fitBounds(bounds.pad(0.25));

            window.addEventListener('resize', () => map.invalidateSize(), { passive: true });
          })
          .catch((error) => {
            console.warn('Heatmap unavailable:', error);
            showMessage('No fue posible cargar la densidad de antenas.');
          });
      })();
    </script>

    <%- include('../includes/scripts') %>
    <%- include('../includes/footer') %>
  </body>
</html>
