<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>

    <main class="container page-offset-wide">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <h2 class="title mb-2">OSINT</h2>
          <p class="text-muted text-center mb-4">
            Verifica tu propio número y comparte los datos de perfil que autorices desde Truecaller.
          </p>

          <% if (!truecallerConfigured) { %>
            <div class="alert alert-warning" role="status">
              La integración aún no está configurada. El administrador debe establecer
              <code>TRUECALLER_APP_KEY</code>, <code>TRUECALLER_APP_NAME</code>,
              <code>TRUECALLER_PRIVACY_URL</code> y <code>TRUECALLER_TERMS_URL</code> en el servidor.
            </div>
          <% } %>

          <div class="d-grid col-md-8 mx-auto">
            <button id="truecallerButton" class="btn btn-primary btn-lg"
              type="button" <%= truecallerConfigured ? '' : 'disabled' %>>
              Verificar mi perfil con Truecaller
            </button>
          </div>
          <p class="small text-muted text-center mt-3 mb-0">
            Requiere un dispositivo Android con Truecaller instalado. No permite buscar perfiles de otras personas.
            Los datos recibidos se muestran solo durante esta sesión y no se guardan.
          </p>
          <p class="small text-center mt-2 mb-0">
            <a href="/terminos" target="_blank" rel="noopener noreferrer">Consulta los términos y condiciones</a>
          </p>

          <div id="truecallerStatus" class="alert mt-4 d-none" role="status" aria-live="polite"></div>
          <section id="truecallerProfile" class="mt-4 d-none" aria-live="polite">
            <h3 class="h5 mb-3">Perfil compartido</h3>
            <div class="table-responsive">
              <table class="table table-bordered mb-0">
                <tbody id="truecallerProfileDetails"></tbody>
              </table>
            </div>
          </section>
        </div>
      </div>
    </main>

    <script>
      (() => {
        const button = document.getElementById('truecallerButton');
        const statusBox = document.getElementById('truecallerStatus');
        const profileBox = document.getElementById('truecallerProfile');
        const profileDetails = document.getElementById('truecallerProfileDetails');
        let verification = null;

        const setStatus = (message, type = 'info') => {
          statusBox.className = `alert alert-${type} mt-4`;
          statusBox.textContent = message;
        };

        const addRow = (label, value) => {
          if (!value) return;
          const row = document.createElement('tr');
          const heading = document.createElement('th');
          heading.scope = 'row';
          heading.textContent = label;
          const cell = document.createElement('td');
          cell.textContent = value;
          row.append(heading, cell);
          profileDetails.appendChild(row);
        };

        const renderProfile = (profile) => {
          profileDetails.replaceChildren();
          addRow('Nombre', profile.name);
          addRow('Teléfonos', profile.phoneNumbers.join(', '));
          addRow('Correo', profile.email);
          addRow('Puesto', profile.jobTitle);
          addRow('Empresa', profile.companyName);
          addRow('Acerca de', profile.aboutMe);
          profile.addresses.forEach((address, index) => {
            const value = [address.street, address.city, address.zipcode, address.countryCode].filter(Boolean).join(', ');
            addRow(`Dirección ${index + 1}`, value);
          });
          profileBox.classList.remove('d-none');
        };

        const pause = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

        const pollForProfile = async (requestNonce) => {
          for (let attempt = 0; attempt < 10; attempt += 1) {
            await pause(3000);
            const response = await fetch(`/api/truecaller/result/${encodeURIComponent(requestNonce)}`, {
              credentials: 'same-origin',
              cache: 'no-store',
              headers: { Accept: 'application/json' },
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible consultar el resultado.');
            if (!['pending', 'flow_invoked', 'processing', 'complete', 'rejected', 'failed'].includes(payload.status)) {
              throw new Error('La sesión expiró. Recarga la página e inténtalo de nuevo.');
            }
            if (payload.status === 'complete') {
              renderProfile(payload.profile);
              setStatus('Perfil recibido con autorización.', 'success');
              return;
            }
            if (payload.status === 'rejected') {
              setStatus('No se compartió el perfil. Puedes volver a intentarlo cuando quieras.', 'warning');
              return;
            }
            if (payload.status === 'failed') {
              setStatus('No fue posible obtener el perfil. Inténtalo nuevamente.', 'danger');
              return;
            }
          }
          setStatus('La verificación sigue pendiente o expiró. Si aprobaste el perfil, vuelve a intentarlo.', 'warning');
        };

        const prepareVerification = async () => {
          button.disabled = true;
          try {
            const response = await fetch('/api/truecaller/start', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { Accept: 'application/json' },
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible preparar la verificación.');
            if (![payload.requestNonce, payload.partnerKey, payload.partnerName, payload.privacyUrl, payload.termsUrl]
              .every((value) => typeof value === 'string' && value.length > 0)) {
              throw new Error('No fue posible preparar la verificación. Recarga la página.');
            }
            verification = payload;
            button.disabled = false;
          } catch (error) {
            setStatus(error.message || 'No fue posible preparar la verificación.', 'danger');
          }
        };

        if (!button.disabled) prepareVerification();

        button.addEventListener('click', async () => {
          if (!/Android/i.test(navigator.userAgent)) {
            setStatus('La verificación web de Truecaller está disponible en navegadores Android.', 'warning');
            return;
          }
          if (!verification) {
            setStatus('La verificación todavía se está preparando. Inténtalo de nuevo en unos segundos.', 'warning');
            return;
          }

          button.disabled = true;
          profileBox.classList.add('d-none');
          statusBox.classList.add('d-none');
          const payload = verification;
          verification = null;
          try {
            const parameters = new URLSearchParams({
              type: 'btmsheet',
              requestNonce: payload.requestNonce,
              partnerKey: payload.partnerKey,
              partnerName: payload.partnerName,
              lang: 'es',
              privacyUrl: payload.privacyUrl,
              termsUrl: payload.termsUrl,
              ttl: '60000',
            });
            let appOpened = false;
            const onBlur = () => { appOpened = true; };
            window.addEventListener('blur', onBlur, { once: true });
            window.location.href = `truecallersdk://truesdk/web_verify?${parameters.toString()}`;
            await pause(700);
            window.removeEventListener('blur', onBlur);
            if (document.hasFocus() && !appOpened) {
              setStatus('No se detectó Truecaller. Instálalo y vuelve a intentarlo.', 'warning');
              return;
            }

            setStatus('Esperando a que autorices compartir tu perfil en Truecaller…');
            await pollForProfile(payload.requestNonce);
          } catch (error) {
            setStatus(error.message || 'No fue posible iniciar la verificación.', 'danger');
          } finally {
            await prepareVerification();
          }
        });
      })();
    </script>
    <%- include('../includes/scripts') %>
  </body>
</html>
