<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>

    <main class="container page-offset-wide">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <h2 class="title mb-2">Consulta telefónica extranjera</h2>
          <p class="text-muted text-center mb-4">Ingresa el número con código de país. Ejemplo: 18082803132</p>

          <form id="phoneLookupForm" class="row g-2 justify-content-center" novalidate>
            <div class="col-md-8">
              <label class="visually-hidden" for="phoneNumber">Número telefónico</label>
              <input id="phoneNumber" class="form-control form-control-lg" type="tel" inputmode="tel"
                placeholder="Código de país y número" autocomplete="off" maxlength="20" required />
            </div>
            <div class="col-md-4 d-grid">
              <button id="phoneLookupButton" class="btn btn-primary btn-lg" type="submit">Buscar</button>
            </div>
          </form>

          <div id="phoneError" class="alert alert-danger mt-4 d-none" role="alert"></div>
          <div id="phoneLoading" class="text-center mt-4 d-none">Consultando información…</div>

          <section id="phoneResult" class="mt-4 d-none" aria-live="polite">
            <div class="alert" id="phoneValidStatus"></div>
            <div class="row g-3 mb-4" id="phoneHighlights"></div>
            <div class="table-responsive">
              <table class="table table-bordered mb-0">
                <tbody id="phoneDetails"></tbody>
              </table>
            </div>
          </section>
        </div>
      </div>
      <footer class="text-center text-muted small mt-3 mb-4">
        La consulta realizada por este servicio es obtenida de fuente abierta y no garantiza la veracidad de la información. El uso de este servicio es bajo su propio riesgo.
      </footer>
    </main>

    <script>
      const form = document.getElementById('phoneLookupForm');
      const input = document.getElementById('phoneNumber');
      const button = document.getElementById('phoneLookupButton');
      const loading = document.getElementById('phoneLoading');
      const errorBox = document.getElementById('phoneError');
      const resultBox = document.getElementById('phoneResult');
      const statusBox = document.getElementById('phoneValidStatus');
      const highlights = document.getElementById('phoneHighlights');
      const details = document.getElementById('phoneDetails');

      const displayValue = (value) => value === null || value === undefined || value === '' ? 'No disponible' : String(value);

      const setError = (message) => {
        errorBox.textContent = message;
        errorBox.classList.remove('d-none');
      };

      const createHighlight = (label, value) => {
        const column = document.createElement('div');
        column.className = 'col-md-4';
        const card = document.createElement('div');
        card.className = 'card h-100 bg-light border-0';
        const body = document.createElement('div');
        body.className = 'card-body';
        const heading = document.createElement('div');
        heading.className = 'text-uppercase text-muted small fw-bold mb-1';
        heading.textContent = label;
        const text = document.createElement('div');
        text.className = 'fs-5 fw-semibold';
        text.textContent = displayValue(value);
        body.append(heading, text);
        card.appendChild(body);
        column.appendChild(card);
        return column;
      };

      const addDetail = (label, value) => {
        const row = document.createElement('tr');
        const title = document.createElement('th');
        title.scope = 'row';
        title.style.width = '40%';
        title.textContent = label;
        const text = document.createElement('td');
        text.textContent = displayValue(value);
        row.append(title, text);
        details.appendChild(row);
      };

      const renderResult = (data) => {
        statusBox.className = `alert ${data.valid ? 'alert-success' : 'alert-warning'}`;
        statusBox.textContent = data.valid ? 'Número válido' : 'El servicio no pudo validar este número.';
        highlights.replaceChildren(
          createHighlight('País', data.country_name),
          createHighlight('Ciudad', data.location),
          createHighlight('Operador', data.carrier),
        );
        details.replaceChildren();
        addDetail('Número', data.number);
        addDetail('Formato local', data.local_format);
        addDetail('Formato internacional', data.international_format);
        addDetail('Código de país', data.country_code);
        addDetail('Prefijo de país', data.country_prefix);
        addDetail('Tipo de línea', data.line_type);
        resultBox.classList.remove('d-none');
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const number = input.value.replace(/\D/g, '');
        errorBox.classList.add('d-none');
        resultBox.classList.add('d-none');

        if (number.length < 7 || number.length > 15) {
          setError('Ingresa un número de 7 a 15 dígitos, incluyendo el código de país.');
          input.focus();
          return;
        }

        button.disabled = true;
        loading.classList.remove('d-none');
        try {
          const response = await fetch('/api/telefono/validar', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ number }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload.error || 'No fue posible realizar la consulta.');
          renderResult(payload.result);
        } catch (error) {
          setError(error.message || 'No fue posible realizar la consulta.');
        } finally {
          button.disabled = false;
          loading.classList.add('d-none');
        }
      });
    </script>
    <%- include('../includes/scripts') %>
  </body>
</html>
