<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container page-offset">
      <div class="row justify-content-md-center">
        <div class="col-md-6 mt-5">
          <div class="card p-4">
            <h2 class="text-center title">Editar línea</h2>
            <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
            <form action="/lineas/editar/<%= objetivo.idObjetivo %>" method="POST">
              <div class="mb-3">
                <label for="numObjetivo" class="form-label">Objetivo</label>
                <input id="numObjetivo" name="numObjetivo" class="form-control" value="<%= objetivo.numObjetivo %>" required>
              </div>
              <div class="mb-3">
                <label for="nuc" class="form-label">NUC</label>
                <input id="nuc" name="nuc" class="form-control" value="<%= objetivo.nuc %>" required>
              </div>
              <div class="mb-3">
                <label for="delito" class="form-label">Delito</label>
                <input type="text" id="delito" name="delito" class="form-control" maxlength="255" value="<%= objetivo.delito || '' %>" placeholder="Ingrese el delito (opcional)">
              </div>
              <div class="mb-3">
                <label for="ano" class="form-label">Año</label>
                <input id="ano" name="ano" type="number" min="1900" max="2200" class="form-control" value="<%= objetivo.ano %>" required>
              </div>
              <div class="mb-3">
                <label for="tipo" class="form-label">Tipo</label>
                <select id="tipo" name="tipo" class="form-select" required>
                  <option value="Solución" <%= objetivo.tipo === 'Solución' ? 'selected' : '' %>>Solución</option>
                  <option value="Seguimiento" <%= objetivo.tipo === 'Seguimiento' ? 'selected' : '' %>>Seguimiento</option>
                </select>
              </div>
              <div class="d-flex gap-2">
                <a class="btn btn-secondary flex-fill" href="/Crud">Cancelar</a>
                <button class="btn btn-primary flex-fill" type="submit">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    <%- include('../includes/scripts') %>
  </body>
</html>
