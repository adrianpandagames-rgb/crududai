<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container page-offset">
      <div class="row justify-content-md-center">
        <div class="col-lg-8 mt-5">
          <h1 class="title text-center mb-4">Notificaciones</h1>
          <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
          <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <div class="btn-group" role="group" aria-label="Filtrar notificaciones">
              <a class="btn btn-sm <%= soloNoLeidas ? 'btn-outline-secondary' : 'btn-secondary' %>" href="/cuenta/notificaciones"<%- soloNoLeidas ? '' : ' aria-current="page"' %>>Todas</a>
              <a class="btn btn-sm <%= soloNoLeidas ? 'btn-secondary' : 'btn-outline-secondary' %>" href="/cuenta/notificaciones?filtro=no-leidas"<%- soloNoLeidas ? ' aria-current="page"' : '' %>>Sin leer</a>
            </div>
            <form action="/cuenta/notificaciones/leer-todas" method="POST" class="ms-auto">
              <button class="btn btn-sm btn-outline-primary" type="submit">Marcar todas como leídas</button>
            </form>
            <form action="/cuenta/notificaciones/eliminar-leidas" method="POST">
              <button class="btn btn-sm btn-outline-danger" type="submit">Borrar las leídas</button>
            </form>
          </div>

          <% if (!notificaciones.length) { %>
          <div class="card p-4 text-center text-muted"><%= soloNoLeidas ? 'No tienes notificaciones sin leer.' : 'Aún no tienes notificaciones.' %></div>
          <% } else { %>
          <ul class="list-group mb-3">
            <% notificaciones.forEach((aviso) => { %>
            <li class="list-group-item d-flex gap-3 align-items-start<%= aviso.leida ? '' : ' fw-semibold' %>">
              <span class="mt-2 rounded-circle flex-shrink-0" style="width: 8px; height: 8px; background: <%= aviso.leida ? 'transparent' : '#198754' %>;" aria-hidden="true"></span>
              <div class="flex-fill">
                <div><%= aviso.titulo %><% if (!aviso.leida) { %><span class="visually-hidden"> (sin leer)</span><% } %></div>
                <div class="small<%= aviso.leida ? ' text-muted' : '' %>" style="font-weight: normal;"><%= aviso.mensaje %></div>
                <div class="small text-muted" style="font-weight: normal;"><%= aviso.creada %></div>
              </div>
              <% if (aviso.url || !aviso.leida) { %>
              <form action="/cuenta/notificaciones/<%= aviso.id %>/abrir" method="POST">
                <button class="btn btn-sm btn-outline-secondary" type="submit"><%= aviso.url ? 'Abrir' : 'Marcar leída' %></button>
              </form>
              <% } %>
            </li>
            <% }) %>
          </ul>
          <% if (totalPages > 1) { %>
          <nav aria-label="Páginas de notificaciones">
            <ul class="pagination justify-content-center">
              <% for (let page = 1; page <= totalPages; page += 1) { %>
              <li class="page-item<%= page === currentPage ? ' active' : '' %>">
                <a class="page-link" href="/cuenta/notificaciones?<%= new URLSearchParams({ ...(soloNoLeidas ? { filtro: 'no-leidas' } : {}), page: String(page) }) %>"<%- page === currentPage ? ' aria-current="page"' : '' %>><%= page %></a>
              </li>
              <% } %>
            </ul>
          </nav>
          <% } %>
          <% } %>
          <p class="small text-muted text-center">Se conservan los últimos 90 días.</p>
        </div>
      </div>
    </main>
    <%- include('../includes/scripts') %>
    <%- include('../includes/footer') %>
  </body>
</html>
