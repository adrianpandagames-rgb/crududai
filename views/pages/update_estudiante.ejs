<!DOCTYPE html>
<html lang="es">
  <head>
    <link
      rel="shortcut icon"
      href="public/imgs/favicon.ico"
      type="image/x-icon" />

    <!--fuente-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu&display=swap"
      rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/public/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/public/css/menu.css" />
    <link rel="stylesheet" href="/public/css/home.css" />
    <title>Detalles del Estudiante</title>
  </head>
  <body>
    <header class="header">
      <a href="/" class="logo">
        <img src="/public/imgs/logo.png" alt="Logo" />
      </a>
      <input class="menu-btn" type="checkbox" id="menu-btn" />
      <label class="menu-icon" for="menu-btn"
        ><span class="navicon"></span
      ></label>
      <ul class="menu">
        <li>
          <a class="menu-item" href="/"> Inicio </a>
        </li>
        <li>
          <a class="menu-item" href="/Crud">
            Crud
          </a>
        </li>
      </ul>
    </header>

    <div class="container page-offset">
      <div class="row justify-content-md-center mb-5">
        <div class="col-md-6 mb-5">
          <div class="card p-4">
            <h3 class="text-center mb-4">
              <a href="/Crud">
                <i class="bi bi-arrow-left-circle"></i>
              </a>
              Actualizar Objetivo
            </h3>
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger" id="formError"><%= error %></div>
            <% } else { %>
              <div class="alert alert-danger d-none" id="formError"></div>
            <% } %>

            <form id="updateForm" action="/actualizar-estudiante/<%= estudiante.id_estudiante %>" method="POST">
              <input type="hidden" name="_method" value="PUT">
              <div class="mb-3">
                <label for="nombre_alumno" class="form-label"> Objetivo </label>
                <input
                  type="text"
                  name="nombre_alumno"
                  class="form-control"
                  value="<%= estudiante.nombre_alumno %>"
                />
              </div>
              <div class="mb-3">
                <label for="email_alumno" class="form-label"> NUC </label>
                <input
                  type="email"
                  name="email_alumno"
                  class="form-control"
                  value="<%= estudiante.email_alumno %>"
                />
              </div>
              <div class="mb-3">
                <label for="curso_alumno">Curso</label>
                <select id="curso_alumno" name="curso_alumno" class="form-select" required>
                  <option value="" disabled <% if (estudiante.curso_alumno === "") { %>selected<% } %>>Seleccionar el curso</option>
                  <option value="Solución" <% if (estudiante.curso_alumno === "Solución") { %>selected<% } %>>Solución</option>
                  <option value="Seguimiento" <% if (estudiante.curso_alumno === "Seguimiento") { %>selected<% } %>>Seguimiento</option>
                </select>
              </div>

              <div class="d-grid gap-2 col-12 mx-auto mt-4">
                <button class="btn btn-primary" type="submit">
                  Actualizar Objetivo
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
    <%- include('../includes/scripts') %>
    <script>
      (function() {
        var $ = window.jQuery;
        if (!$) return;
        $('#updateForm').on('submit', function(e) {
          var val = $('#curso_alumno').val();
          if (!val || val.toString().trim() === '') {
            e.preventDefault();
            $('#formError').removeClass('d-none').text('El campo "Curso" es obligatorio.');
            return false;
          }
          return true;
        });
      })();
    </script>
  </body>
</html>
