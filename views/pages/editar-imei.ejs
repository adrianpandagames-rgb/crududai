<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
  </head>
  <body>
    <%- include('../includes/header') %>
    <main class="container page-offset">
      <div class="row justify-content-md-center">
        <div class="col-md-7 mt-5">
          <div class="card p-4">
            <h2 class="text-center title">Editar IMEI</h2>
            <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
            <form action="/imei/editar/<%= imei.idImei %>" method="POST">
              <div class="mb-3">
                <label for="imei" class="form-label">IMEI</label>
                <input id="imei" name="imei" inputmode="numeric" maxlength="15" class="form-control" value="<%= imei.imei %>" required>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="numObjetivo" class="form-label">Objetivo</label>
                  <input id="numObjetivo" name="numObjetivo" class="form-control" value="<%= imei.numObjetivo %>" required>
                </div>
                <div class="col-md-6">
                  <label for="nuc" class="form-label">NUC</label>
                  <input id="nuc" name="nuc" class="form-control" value="<%= imei.nuc %>" required>
                </div>
                <div class="col-md-4">
                  <label for="ano" class="form-label">Año</label>
                  <input id="ano" name="ano" type="number" min="1900" max="2200" class="form-control" value="<%= imei.ano %>" required>
                </div>
                <div class="col-md-8">
                  <label for="tipo" class="form-label">Tipo</label>
                  <select id="tipo" name="tipo" class="form-select" required>
                    <option value="Solución" <%= imei.tipo === 'Solución' ? 'selected' : '' %>>Solución</option>
                    <option value="Seguimiento" <%= imei.tipo === 'Seguimiento' ? 'selected' : '' %>>Seguimiento</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="brandName" class="form-label">Marca</label>
                  <input id="brandName" name="brandName" class="form-control" value="<%= imei.brand_name || '' %>">
                </div>
                <div class="col-md-6">
                  <label for="modelo" class="form-label">Modelo</label>
                  <input id="modelo" name="modelo" class="form-control" value="<%= imei.modelo || '' %>">
                </div>
              </div>
              <div class="d-flex gap-2 mt-4">
                <a class="btn btn-secondary flex-fill" href="/imei">Cancelar</a>
                <button class="btn btn-primary flex-fill" type="submit">Guardar cambios</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
    <%- include('../includes/scripts') %>
  </body>
</html>
