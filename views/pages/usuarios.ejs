<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../includes/head') %>
    <style>
      .user-management-table .user-actions {
        display: grid;
        grid-template-columns: repeat(2, 140px);
        align-items: center;
        justify-content: end;
        column-gap: .2rem;
        row-gap: .35rem;
        min-width: 300px;
      }

      .user-management-table .user-actions form {
        display: contents;
        margin: 0;
        padding: 0;
        background: transparent;
        border-radius: 0;
        box-shadow: none;
      }

      .user-management-table .user-actions .user-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        justify-self: center;
        width: 140px;
        height: 44px;
        min-height: 44px;
        padding: .35rem .55rem;
        border-radius: .375rem;
        font-size: .78rem;
        font-weight: 600;
        line-height: 1.2;
        text-align: center;
        white-space: nowrap;
      }

      .btn-outline-purple {
        color: #6f42c1;
        border-color: #6f42c1;
      }

      .btn-outline-purple:hover {
        color: #fff;
        background-color: #6f42c1;
        border-color: #6f42c1;
      }

      .user-management-table .user-actions select.user-action-button {
        width: 140px;
        height: 44px;
        min-height: 44px;
      }

      .user-management-table .user-actions .user-role-button {
        width: 140px;
      }

      .user-management-table .user-actions .user-password-button {
        width: 140px;
      }

      .user-management-table .user-actions .user-status-button {
        width: 140px;
      }

      .user-management-table td[data-label="Rol"],
      .user-management-table td[data-label="Estado"] {
        text-align: center;
        vertical-align: middle;
      }

      @media (max-width: 767.98px) {
        .user-management-table,
        .user-management-table tbody,
        .user-management-table tr,
        .user-management-table td {
          display: block;
          width: 100%;
        }

        .user-management-table thead {
          display: none;
        }

        .user-management-table tr {
          margin-bottom: 1rem;
          padding: .75rem;
          border: 1px solid #dee2e6;
          border-radius: .375rem;
        }

        .user-management-table td {
          padding: .35rem 0;
          text-align: left !important;
          white-space: normal !important;
        }

        .user-management-table td::before {
          content: attr(data-label);
          display: block;
          margin-bottom: .25rem;
          font-weight: 600;
        }

        .user-management-table .user-actions {
          display: flex !important;
          align-items: stretch !important;
          flex-direction: column !important;
          justify-content: flex-start !important;
          min-width: 0;
        }

        .user-management-table .user-actions form {
          display: flex;
          align-items: center;
          gap: .35rem;
          width: 100%;
        }

        .user-management-table .user-actions form:first-child {
          display: flex;
          grid-column: auto;
          flex-wrap: wrap;
        }

        .user-management-table .user-actions .user-action-button,
        .user-management-table .user-actions select.user-action-button {
          width: 100%;
          min-height: 44px;
        }

        .user-management-table .user-actions select.user-action-button {
          flex: 1 1 150px;
        }

        .user-management-table .user-actions .user-role-button,
        .user-management-table .user-actions .user-password-button,
        .user-management-table .user-actions .user-status-button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <%- include('../includes/header') %>

    <main class="content-wrapper mt-5 page-offset">
      <div class="container py-4 page-container-medium">
        <h2 class="title mb-4">Administración de usuarios</h2>

        <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <% if (generatedPassword) { %>
          <div class="alert alert-warning">
            <strong>Contraseña temporal:</strong>
            <code id="generated-password" class="ms-2"><%= generatedPassword %></code>
            <button id="copy-password" type="button" class="btn btn-sm btn-outline-dark ms-2">Copiar</button>
            <div class="small mt-2">Se muestra solo ahora. Compártela con el usuario mediante un canal seguro.</div>
          </div>
        <% } %>

        <section class="card mb-4">
          <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
              <h3 class="h5 mb-1">Google Geocoding</h3>
              <p class="mb-0">Consultas a la API: <strong><%= googleGeocodingQuota.requestCount %> / <%= googleGeocodingQuota.limit %></strong></p>
              <% if (googleGeocodingQuota.isBlocked) { %>
                <div class="alert alert-danger mt-3 mb-0" role="alert">ALARMA: se alcanzó el límite de consultas. Geocoding está bloqueado hasta reiniciar el contador.</div>
              <% } %>
            </div>
            <form action="/usuarios/google-geocoding/reiniciar" method="POST" onsubmit="return confirm('¿Reiniciar el contador de Google Geocoding y desbloquear el servicio?');">
              <button class="btn btn-outline-danger" type="submit">Reiniciar contador y desbloquear</button>
            </form>
          </div>
        </section>

        <section class="card mb-4">
          <div class="card-body">
            <h3 class="h5">Agregar usuario</h3>
            <p class="text-muted">Al crear el usuario, el sistema generará una contraseña segura y guardará únicamente su hash.</p>
            <form action="/usuarios" method="POST" class="row g-2">
              <div class="col-md-5">
                <label class="visually-hidden" for="email">Correo</label>
                <input class="form-control" type="email" name="email" id="email" placeholder="correo@ejemplo.com" required autocomplete="email">
              </div>
              <div class="col-md-3">
                <label class="visually-hidden" for="new-user-role">Tipo de usuario</label>
                <select class="form-select" name="role" id="new-user-role" aria-label="Tipo de usuario">
                  <option value="usuario" selected>Usuario</option>
                  <option value="uecs">UECS</option>
                  <option value="semiadmin">Semiadministrador</option>
                  <option value="admin">Administrador</option>
                </select>
              </div>
              <div class="col-md-4">
                <button class="btn btn-primary w-100" type="submit">Crear y generar contraseña</button>
              </div>
            </form>
          </div>
        </section>

        <section class="card">
          <div class="card-body">
            <h3 class="h5 mb-3">Usuarios</h3>
            <div class="table-responsive user-management-table-wrapper">
              <table class="table align-middle user-management-table">
                <thead><tr><th>Correo</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                  <% users.forEach((user) => { %>
                    <tr>
                      <td data-label="Correo"><%= user.email %></td>
                      <td data-label="Rol">
                        <% const userRole = Number(user.is_admin) === 1 ? 'admin' : (user.role || 'usuario'); %>
                        <span class="badge <%= userRole === 'admin' ? 'bg-primary' : userRole === 'semiadmin' ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= userRole === 'admin' ? 'Administrador' : userRole === 'semiadmin' ? 'Semiadministrador' : userRole === 'uecs' ? 'UECS' : 'Usuario' %></span>
                      </td>
                      <td data-label="Estado"><span class="badge <%= Number(user.is_active) === 1 ? 'bg-success' : 'bg-danger' %>"><%= Number(user.is_active) === 1 ? 'Activo' : 'Deshabilitado' %></span></td>
                      <td class="text-end" data-label="Acciones">
                        <div class="user-actions">
                        <form action="/usuarios/<%= user.id %>/rol" method="POST">
                          <select name="role" class="form-select form-select-sm user-action-button" aria-label="Rol de <%= user.email %>">
                            <option value="usuario" <%= userRole === 'usuario' ? 'selected' : '' %>>Usuario</option>
                            <option value="uecs" <%= userRole === 'uecs' ? 'selected' : '' %>>UECS</option>
                            <option value="semiadmin" <%= userRole === 'semiadmin' ? 'selected' : '' %>>Semiadministrador</option>
                            <option value="admin" <%= userRole === 'admin' ? 'selected' : '' %>>Administrador</option>
                          </select>
                          <button class="btn btn-sm btn-outline-primary user-action-button user-role-button" type="submit">Guardar rol</button>
                        </form>
                        <form action="/usuarios/<%= user.id %>/restablecer-contrasena" method="POST">
                          <button class="btn btn-sm btn-outline-secondary user-action-button user-password-button" type="submit" <% if (Number(user.is_initial_admin) === 1 && user.id !== currentUser.id) { %>disabled title="Solo el administrador inicial puede cambiar su contraseña"<% } %>>Generar contraseña</button>
                        </form>
                        <form action="/usuarios/<%= user.id %>/estado" method="POST">
                          <input type="hidden" name="isActive" value="<%= Number(user.is_active) === 1 ? '0' : '1' %>">
                          <button class="btn btn-sm btn-outline-<%= Number(user.is_active) === 1 ? 'danger' : 'success' %> user-action-button user-status-button" type="submit" <%= user.id === currentUser.id && Number(user.is_active) === 1 ? 'disabled' : '' %>><%= Number(user.is_active) === 1 ? 'Deshabilitar' : 'Habilitar' %></button>
                        </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script>
      document.getElementById('copy-password')?.addEventListener('click', async () => {
        const password = document.getElementById('generated-password').textContent;
        await navigator.clipboard.writeText(password);
      });
    </script>
    <%- include('../includes/scripts') %>
  </body>
</html>
