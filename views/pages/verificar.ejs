<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificación en dos pasos</title>
    <%- include('../includes/theme') %>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <img src="/public/imgs/logo.png" alt="Logo" />
        </div>
        <h2>Verificación en dos pasos</h2>
        <p class="subtitle">Confirma que eres tú para terminar de iniciar sesión.</p>

        <div class="error-box" id="verificarError" role="alert"<%- error ? '' : ' hidden' %>><%= error || '' %></div>
        <% if (aviso) { %><div class="success-box" role="status"><%= aviso %></div><% } %>

        <% if (passkeysDisponibles && !codigoEnviado) { %>
        <button type="button" class="login-btn" id="verificarPasskey">Usar huella o llave de acceso</button>
        <p class="subtitle mt-2" id="verificarSinSoporte" hidden>Este navegador no admite llaves de acceso. Usa el código por correo.</p>
        <% } %>

        <% if (codigoEnviado) { %>
        <form action="/verificar/correo" method="POST" autocomplete="off" class="mt-3">
            <div class="input-group">
                <label for="codigoCorreo">Código de 6 dígitos enviado a <%= correoOculto %></label>
                <input type="text" id="codigoCorreo" name="codigo" placeholder="000000" required inputmode="numeric" pattern="[0-9 ]{6,7}"
                    maxlength="7" autocomplete="one-time-code" autofocus>
            </div>
            <button type="submit" class="login-btn">Verificar código</button>
        </form>
        <% } %>

        <% if (puedeEnviar) { %>
        <form action="/verificar/correo/enviar" method="POST" class="mt-3">
            <button type="submit" class="<%= codigoEnviado ? 'login-link' : 'login-btn login-btn-secondary' %>">
                <%= codigoEnviado ? 'Enviar otro código' : `Enviar un código a ${correoOculto}` %>
            </button>
        </form>
        <% } %>

        <% if (codigoEnviado && passkeysDisponibles) { %>
        <form action="/verificar" method="GET" class="mt-2">
            <button type="button" class="login-link" id="verificarPasskey">Usar huella o llave de acceso</button>
        </form>
        <% } %>

        <details class="mt-3">
            <summary>Usar un código de recuperación</summary>
            <form action="/verificar/codigo" method="POST" autocomplete="off" class="mt-2">
                <div class="input-group">
                    <label for="codigo">Código de recuperación</label>
                    <input type="text" id="codigo" name="codigo" placeholder="XXXXX-XXXXX" required maxlength="20"
                        autocapitalize="characters" spellcheck="false" autocomplete="off">
                </div>
                <button type="submit" class="login-btn">Entrar con el código</button>
            </form>
        </details>

        <form action="/verificar/cancelar" method="POST" class="text-center mt-3">
            <button type="submit" class="login-link">Cancelar e iniciar sesión con otra cuenta</button>
        </form>
    </div>
    <script src="/vendor/simplewebauthn-browser.js"></script>
    <script src="/public/js/dos-pasos.js"></script>
</body>
</html>
