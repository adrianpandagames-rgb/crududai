<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificación en dos pasos</title>
    <%- include('../includes/theme') %>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <img src="/public/imgs/logo.png" alt="Logo" />
        </div>
        <h2>Verificación en dos pasos</h2>
        <p class="subtitle">Confirma que eres tú con la huella, el rostro o el PIN de tu dispositivo.</p>

        <div class="error-box" id="verificarError" role="alert"<%- error ? '' : ' hidden' %>><%= error || '' %></div>

        <% if (passkeysDisponibles) { %>
        <button type="button" class="login-btn" id="verificarPasskey">Verificar con llave de acceso</button>
        <p class="subtitle mt-2" id="verificarSinSoporte" hidden>Este navegador no admite llaves de acceso. Usa un código de recuperación.</p>
        <% } %>

        <details class="mt-3"<%- passkeysDisponibles ? '' : ' open' %>>
            <summary>Usar un código de recuperación</summary>
            <form action="/verificar/codigo" method="POST" autocomplete="off" class="mt-2">
                <div class="input-group">
                    <label for="codigo">Código de recuperación</label>
                    <input type="text" id="codigo" name="codigo" placeholder="XXXXX-XXXXX" required maxlength="20"
                        autocapitalize="characters" spellcheck="false" autocomplete="one-time-code">
                </div>
                <button type="submit" class="login-btn">Entrar con el código</button>
            </form>
        </details>

        <form action="/verificar/cancelar" method="POST" class="text-center mt-3">
            <button type="submit" class="btn btn-link p-0">Cancelar e iniciar sesión con otra cuenta</button>
        </form>
    </div>
    <script src="/vendor/simplewebauthn-browser.js"></script>
    <script src="/public/js/dos-pasos.js"></script>
</body>
</html>
