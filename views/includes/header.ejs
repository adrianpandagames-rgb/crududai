<%# The section being viewed gets a light (see menu.css); sub-pages such as /imei/editar/5 count too. %>
<% const navPath = (typeof currentPath === 'string' ? currentPath : '').toLowerCase().replace(/\/+$/, '') || '/'; %>
<% const navAt = (...paths) => paths.some((path) => navPath === path.toLowerCase() || navPath.startsWith(path.toLowerCase() + '/')); %>
<% const user = typeof currentUser !== 'undefined' && currentUser ? currentUser : {}; %>
<% const isUecs = user.role === 'uecs'; %>
<% const isAdmin = Boolean(user.isAdmin) && !isUecs; %>
<%# Each group lists [label, href, extra paths that belong to it]; links the user may not open are left out. %>
<% const groups = [
  { label: 'Datos conservados', links: [
    ['Ficha de línea o caso', '/ficha'],
    ['Líneas', '/Crud', ['/lineas', '/estudiantes']],
    ['IMEI', '/imei'],
    ['Perfiles', '/perfiles'],
    ['Limpieza', '/limpieza'],
  ] },
  { label: 'Mapeo', links: [
    ['Ubicaciones', '/ubicaciones'],
    ...(user.isAdmin || isUecs ? [['Georeferenciación', '/georeferenciacion']] : []),
    ['Planeación geográfica', '/planeacion-geografica'],
    ['Ruta', '/ruta'],
    ['Coincidencias de antenas', '/coincidencias'],
  ] },
  { label: 'OSINT', links: [
    ['Líneas Internacionales', '/telefono'],
    ['Maigret', '/maigret'],
    ['SpiderFoot', '/spiderfoot'],
    ['RastroX', '/nombres'],
    ['Búsqueda por imagen', '/imagenes'],
  ] },
  { label: 'Administración', admin: true, links: isAdmin ? [
    ['Usuarios', '/usuarios'],
    ['Auditoría', '/auditoria'],
    ['Medidores', '/medidores'],
    ['Red telefónica', '/red-telefonica'],
  ] : [] },
].filter((group) => group.links.length); %>
<% const linkAt = ([, href, extra = []]) => navAt(href, ...extra); %>
<header class="header">
  <a href="/Crud" class="logo">
    <img src="/public/imgs/logo.png" alt="Logo" />
    <span class="logo-text">Unidad de Análisis</span>
  </a>
  <input class="menu-btn" type="checkbox" id="menu-btn" />
  <label class="menu-icon" for="menu-btn"><span class="navicon"></span></label>
  <ul class="menu">
    <% if (!isUecs) { %>
    <li>
      <a class="menu-item<%= navAt('/metricas') ? ' is-current' : '' %>" href="/metricas"<%- navAt('/metricas') ? ' aria-current="page"' : '' %>>Métricas</a>
    </li>
    <li>
      <a class="menu-item<%= navAt('/tareas') ? ' is-current' : '' %>" href="/tareas"<%- navAt('/tareas') ? ' aria-current="page"' : '' %>>Tareas</a>
    </li>
    <% } %>
    <% groups.forEach((group) => { %>
    <% const groupCurrent = group.links.some(linkAt); %>
    <li class="menu-group<%= group.admin ? ' admin-menu' : '' %>">
      <details>
        <summary class="menu-item<%= groupCurrent ? ' is-current' : '' %>"><%= group.label %></summary>
        <ul class="menu-submenu<%= group.admin ? ' admin-submenu' : '' %>">
          <% group.links.forEach((link) => { %>
          <% const [label, href] = link; %>
          <li><a class="menu-item<%= linkAt(link) ? ' is-current' : '' %>" href="<%= href %>"<%- linkAt(link) ? ' aria-current="page"' : '' %>><%= label %></a></li>
          <% }) %>
        </ul>
      </details>
    </li>
    <% }) %>
    <%# The person's own menu: their photo or initial, their name (or e-mail) and how many notices are unread. %>
    <% const displayName = user.nombre || String(user.email || '').split('@')[0]; %>
    <% const unread = Number(user.noLeidas) || 0; %>
    <% const userCurrent = navAt('/cuenta'); %>
    <li class="menu-group user-menu">
      <details>
        <summary class="menu-item<%= userCurrent ? ' is-current' : '' %>" aria-label="Mi cuenta: <%= displayName %><%= unread ? `, ${unread} notificaciones sin leer` : '' %>">
          <% if (user.fotoVersion) { %>
          <img class="user-avatar" src="/cuenta/foto?v=<%= user.fotoVersion %>" alt="" width="28" height="28" />
          <% } else { %>
          <span class="user-avatar user-avatar-initial" aria-hidden="true"><%= (displayName[0] || '?').toUpperCase() %></span>
          <% } %>
          <span class="user-name"><%= displayName %></span>
          <% if (unread) { %><span class="badge rounded-pill bg-danger user-badge" aria-hidden="true"><%= unread > 99 ? '99+' : unread %></span><% } %>
        </summary>
        <ul class="menu-submenu user-submenu">
          <li><a class="menu-item<%= navPath === '/cuenta' ? ' is-current' : '' %>" href="/cuenta">Mi cuenta</a></li>
          <li>
            <a class="menu-item<%= navAt('/cuenta/notificaciones') ? ' is-current' : '' %>" href="/cuenta/notificaciones">Notificaciones
              <% if (unread) { %><span class="badge rounded-pill bg-danger ms-1"><%= unread > 99 ? '99+' : unread %></span><% } %>
            </a>
          </li>
          <%# Shown by pwa.js only when the browser can install the app. %>
          <li hidden><a class="menu-item" href="#" data-instalar-app><i class="bi bi-download" aria-hidden="true"></i> Instalar app</a></li>
          <li><a class="menu-item logout-btn" href="/logout">Cerrar sesión</a></li>
        </ul>
      </details>
    </li>
  </ul>
</header>
<script>
  // Only one group open at a time; clicking elsewhere or pressing Escape closes it.
  (() => {
    const groups = [...document.querySelectorAll('.header .menu-group details')];
    groups.forEach((group) => group.addEventListener('toggle', () => {
      if (group.open) groups.forEach((other) => { if (other !== group) other.open = false; });
    }));
    document.addEventListener('click', (event) => {
      groups.forEach((group) => { if (group.open && !group.contains(event.target)) group.open = false; });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = groups.find((group) => group.open);
      if (!open) return;
      open.open = false;
      open.querySelector('summary').focus();
    });
  })();
</script>
