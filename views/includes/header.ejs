<header class="header">
  <a href="/Crud" class="logo">
    <img src="/public/imgs/logo.png" alt="Logo" />
    <span class="logo-text">Unidad de Análisis</span>
  </a>
  <input class="menu-btn" type="checkbox" id="menu-btn" />
  <label class="menu-icon" for="menu-btn"><span class="navicon"></span></label>
  <ul class="menu">
    <% if (!(typeof currentUser !== 'undefined' && currentUser.role === 'uecs')) { %>
    <li>
      <a class="menu-item" href="/metricas">Métricas</a>
    </li>
    <% } %>
    <li>
      <a class="menu-item" href="/Crud">Líneas</a>
    </li>
    <li>
      <a class="menu-item" href="/imei">IMEI</a>
    </li>
    <li>
      <a class="menu-item" href="/ubicaciones">Ubicaciones</a>
    </li>
    <% if (typeof currentUser !== 'undefined' && (currentUser.isAdmin || currentUser.role === 'uecs')) { %>
    <li>
      <a class="menu-item" href="/georeferenciacion">Georeferenciación</a>
    </li>
    <% } %>
    <li>
      <a class="menu-item" href="/planeacion-geografica">Planeación geográfica</a>
    </li>
    <li>
      <a class="menu-item" href="/ruta">Ruta</a>
    </li>
    <li>
      <a class="menu-item" href="/telefono">Líneas Internacionales</a>
    </li>
    <li>
      <a class="menu-item" href="/maigret">Maigret</a>
    </li>
    <li>
      <a class="menu-item" href="/imagenes">Búsqueda por imagen</a>
    </li>
    <li>
      <a class="menu-item" href="/nombres">Búsqueda por nombre</a>
    </li>
    <% if (typeof currentUser !== 'undefined' && currentUser.isAdmin && currentUser.role !== 'uecs') { %>
    <li class="admin-menu">
      <details>
        <summary class="menu-item">Administración</summary>
        <ul class="admin-submenu">
          <li><a class="menu-item" href="/usuarios">Usuarios</a></li>
          <li><a class="menu-item" href="/auditoria">Auditoría</a></li>
          <li><a class="menu-item" href="/medidores">Medidores</a></li>
          <li><a class="menu-item" href="/red-telefonica">Red telefónica</a></li>
        </ul>
      </details>
    </li>
    <% } %>
    <li>
      <a class="menu-item logout-btn" href="/logout">Cerrar sesión</a>
    </li>
  </ul>
</header>
