<%# The board's columns; also served alone by /tareas/tablero so open pages refresh when someone changes a task.
    A card shows only what helps to scan the board; clicking it opens its details (tarea-detalle) in a window. %>
<% const corto = (email) => String(email || '').split('@')[0]; %>
<% const abreviatura = { licenciado: 'Lic.', ingeniero: 'Ing.' }; %>
<% const editar = (id) => `/tareas/${id}/editar${filtro ? `?volver=${filtro}` : ''}`; %>
<% ESTADOS.forEach((estado) => { %>
  <section class="tareas-columna" aria-labelledby="columna-<%= estado %>">
    <h2 id="columna-<%= estado %>"><%= ESTADO_LABELS[estado] %> <span class="tareas-contador" data-contador><%= columnas[estado].length %></span></h2>
    <div class="tareas-lista" data-estado="<%= estado %>">
      <p class="tareas-vacia">Sin tareas</p>
      <% columnas[estado].forEach((tarea) => { %>
        <% const antiguedad = antiguedadOf(tarea.dias); %>
        <% const etiquetas = tarea.etiquetas || []; %>
        <% const buscar = [tarea.titulo, tarea.descripcion, tarea.licenciado, tarea.ingeniero, ...etiquetas.map((e) => e.nombre)].filter(Boolean).join(' ').toLowerCase(); %>
        <article class="tarea-card<%= antiguedad ? ` is-${antiguedad}` : '' %>" id="tarea-<%= tarea.id %>" data-id="<%= tarea.id %>"
          data-llegada="<%= tarea.fechaLlegada %>" data-buscar="<%= buscar %>" data-etiquetas="<%= etiquetas.map((e) => e.id).join(',') %>">
          <% if (etiquetas.length) { %>
            <div class="tarea-card-etiquetas">
              <% etiquetas.forEach((etiqueta) => { %><span class="tarea-etiqueta etiqueta-<%= etiqueta.color %>"><%= etiqueta.nombre %></span><% }) %>
            </div>
          <% } %>
          <h3 class="tarea-titulo h6"><a class="tarea-abrir" href="<%= editar(tarea.id) %>" draggable="false"><%= tarea.titulo %></a></h3>
          <div class="tarea-meta">
            <% userPuestos.forEach((puesto) => { if (!tarea[puesto]) return; const listo = tarea[`${puesto}Listo`]; %>
              <span class="tarea-chip<%= listo ? ' is-listo' : '' %>"
                title="<%= puesto === 'licenciado' ? 'Licenciado' : 'Ingeniero' %>: <%= tarea[puesto] %><%= listo ? ` · terminó su parte el ${listo}` : '' %>">
                <% if (listo) { %><i class="bi bi-check-circle-fill" aria-hidden="true"></i><% } %>
                <span class="tarea-chip-puesto"><%= abreviatura[puesto] %></span> <%= corto(tarea[puesto]) %><% if (listo) { %> · listo<% } %>
              </span>
            <% }) %>
            <% if (!tarea.licenciado && !tarea.ingeniero) { %>
              <span class="tarea-chip is-sin-asignar">Sin asignar</span>
            <% } %>
          </div>
          <div class="tarea-insignias">
            <span class="tarea-llegada" title="Fecha de llegada"><i class="bi bi-inbox" aria-hidden="true"></i> Llegó <%= tarea.llegada %>
              · <span class="tarea-dias"><%= haceDias(tarea.dias) %></span></span>
            <% if (tarea.descripcion) { %><span title="Tiene descripción"><i class="bi bi-text-left" aria-hidden="true"></i><span class="visually-hidden">Tiene descripción</span></span><% } %>
            <% if (tarea.comentarios) { %>
              <span title="<%= tarea.comentarios === 1 ? '1 comentario' : `${tarea.comentarios} comentarios` %>"><i class="bi bi-chat-left-text" aria-hidden="true"></i> <%= tarea.comentarios %><span class="visually-hidden"> comentarios</span></span>
            <% } %>
            <% if (tarea.checklistTotal) { %>
              <span class="tarea-insignia-checklist<%= tarea.checklistHechos === tarea.checklistTotal ? ' is-completo' : '' %>" title="Checklist">
                <i class="bi bi-check2-square" aria-hidden="true"></i> <%= tarea.checklistHechos %>/<%= tarea.checklistTotal %><span class="visually-hidden"> del checklist</span></span>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
    <%# Typing a title and pressing Enter adds a card to this column. Without JavaScript it posts like the full form. %>
    <details class="tarea-rapida" data-estado="<%= estado %>">
      <summary><i class="bi bi-plus-lg" aria-hidden="true"></i> Añadir tarjeta</summary>
      <form action="/tareas" method="POST" autocomplete="off">
        <input type="hidden" name="estado" value="<%= estado %>" />
        <input type="hidden" name="volver" value="<%= filtro %>" />
        <label class="visually-hidden" for="rapida-titulo-<%= estado %>">Título de la tarjeta</label>
        <textarea id="rapida-titulo-<%= estado %>" name="titulo" class="form-control form-control-sm" rows="2" maxlength="200" required
          placeholder="Título de la tarjeta"></textarea>
        <div class="tarea-rapida-fecha">
          <label for="rapida-llegada-<%= estado %>">Llegó</label>
          <input type="date" id="rapida-llegada-<%= estado %>" name="fechaLlegada" class="form-control form-control-sm" required value="<%= hoy %>" max="<%= hoy %>" />
        </div>
        <div class="tarea-rapida-acciones">
          <button type="submit" class="btn btn-sm btn-primary">Añadir</button>
          <button type="button" class="btn btn-sm btn-link text-secondary" data-cerrar-rapida aria-label="Cancelar"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <p class="tarea-rapida-error small text-danger mb-0" role="alert" hidden></p>
      </form>
    </details>
  </section>
<% }) %>
