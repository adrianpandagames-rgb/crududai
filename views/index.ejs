<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Login</title>
    <!-- Relative route pointing to public/css/style.css -->
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <img src="/public/imgs/logo.png" alt="Logo" />
        </div>
        <h2>UNIDAD DE ANALISIS E INTELIGENCIA</h2>
        <p class="subtitle">Porfavor inicia sesión para accesder a tu panel de control</p>

        <!-- EJS Dynamic Error Alert Panel -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-box"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="success-box"><%= success %></div>
        <% } %>

        <form id="loginForm" action="/login" method="POST" autocomplete="on">
            <div class="input-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Email" required autocomplete="username" autocapitalize="none" spellcheck="false">
            </div>

            <div class="input-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" placeholder="Contraseña" required autocomplete="current-password" autocapitalize="none" spellcheck="false">
            </div>

            <div class="remember-group">
                <input type="checkbox" id="rememberMe" name="rememberMe">
                <label for="rememberMe">Recordar usuario</label>
            </div>

            <button type="submit" class="login-btn">Sign In</button>
        </form>
    </div>
    <script>
        const loginForm = document.getElementById('loginForm');
        const rememberMe = document.getElementById('rememberMe');
        const email = document.getElementById('email');
        const password = document.getElementById('password');

        const STORAGE_EMAIL_KEY = 'rememberedEmail';
        const STORAGE_REMEMBER_KEY = 'rememberLogin';

        const updateAutocomplete = () => {
            email.autocomplete = 'username';
            password.autocomplete = 'current-password';
        };

        const loadRememberedCredentials = () => {
            const rememberLogin = localStorage.getItem(STORAGE_REMEMBER_KEY) === 'true';
            rememberMe.checked = rememberLogin;

            if (rememberLogin) {
                const storedEmail = localStorage.getItem(STORAGE_EMAIL_KEY);
                if (storedEmail) email.value = storedEmail;
            }

            // Delete passwords saved by older versions of the app.
            localStorage.removeItem('rememberedPassword');

            updateAutocomplete();
        };

        const saveCredentials = () => {
            if (rememberMe.checked) {
                localStorage.setItem(STORAGE_REMEMBER_KEY, 'true');
                localStorage.setItem(STORAGE_EMAIL_KEY, email.value || '');
            } else {
                localStorage.removeItem(STORAGE_REMEMBER_KEY);
                localStorage.removeItem(STORAGE_EMAIL_KEY);
            }
        };

        loadRememberedCredentials();

        loginForm.addEventListener('submit', () => {
            saveCredentials();
            updateAutocomplete();
        });
    </script>
</body>
</html>
