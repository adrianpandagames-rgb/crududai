<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Login</title>
    <!-- Relative route pointing to public/css/style.css -->
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <div class="login-container">
        <div class="login-logo">
            <img src="/public/imgs/logo.png" alt="Logo" />
        </div>
        <h2>UNIDAD DE ANALISIS E INTELIGENCIA</h2>
        <p class="subtitle">Porfavor inicia sesión para accesder a tu panel de control</p>

        <!-- EJS Dynamic Error Alert Panel -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-box"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="success-box"><%= success %></div>
        <% } %>

        <form id="loginForm" action="/login" method="POST">
            <div class="input-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Email" required autocomplete="off" autocapitalize="none" spellcheck="false">
            </div>

            <div class="input-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" placeholder="Contraseña" required autocomplete="new-password" autocapitalize="none" spellcheck="false">
            </div>

            <div class="remember-group">
                <input type="checkbox" id="rememberMe" name="rememberMe">
                <label for="rememberMe">Recordar usuario y contraseña en este dispositivo</label>
            </div>

            <button type="submit" class="login-btn">Sign In</button>
        </form>
    </div>
    <script>
        const loginForm = document.getElementById('loginForm');
        const rememberMe = document.getElementById('rememberMe');
        const email = document.getElementById('email');
        const password = document.getElementById('password');

        const updateAutocomplete = () => {
            if (rememberMe.checked) {
                email.autocomplete = 'username';
                password.autocomplete = 'current-password';
            } else {
                email.autocomplete = 'off';
                password.autocomplete = 'new-password';
            }
        };

        rememberMe.checked = localStorage.getItem('rememberLogin') === 'true';
        updateAutocomplete();

        loginForm.addEventListener('submit', () => {
            if (rememberMe.checked) {
                localStorage.setItem('rememberLogin', 'true');
            } else {
                localStorage.removeItem('rememberLogin');
            }
            updateAutocomplete();
        });
    </script>
</body>
</html>
