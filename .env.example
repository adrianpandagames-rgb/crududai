# Copia este archivo como .env y completa tus valores reales localmente.
# Nunca guardes claves reales en el repositorio.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=crudnodejs

# Creación de cuenta con contraseña temporal y avisos de cambios de contraseña.
# Puerto 587 usa STARTTLS obligatorio; 465 usa TLS desde la conexión.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Bot de Telegram: IDs numéricos autorizados, separados por comas.
TELEGRAM_BOT_TOKEN=
# Proceso PM2 que se reinicia al guardar un rol (misma cuenta Linux que Node).
TELEGRAM_BOT_PM2_NAME=crududai-telegram
# Opcional: ruta absoluta de pm2 si no está disponible en PATH.
PM2_EXECUTABLE=
# Clave Base64 de 32 bytes para cifrar los IDs de Telegram vinculados a users.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TELEGRAM_ID_ENCRYPTION_KEY=
# Credencial exclusiva entre Python y Node; distinta del token de BotFather.
TELEGRAM_API_TOKEN=
TELEGRAM_API_BASE_URL=https://localhost:3443
TELEGRAM_API_CA_CERT=certs/runtime-server.crt

HOST=0.0.0.0
PORT=3600
HTTPS_PORT=3443

IMEI_API_KEY=tu_api_key_imei
IMEI_SERVICE_ID=0
PHONE_VALIDATION_ACCESS_KEY=tu_access_key_telefono

# Optional replacement TLS pair; configure both paths or leave both empty.
TLS_KEY_PATH=
TLS_CERT_PATH=

# Clave de servidor con Geocoding API habilitada (no se envía al navegador).
GOOGLE_GEOCODING_API_KEY=

# Fuente vial para calcular entrecalles. Para cargas grandes usa un proveedor propio.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Alternativa ante fallos temporales. Déjalo vacío para desactivar la alternativa.
OVERPASS_FALLBACK_API_URL=https://overpass.private.coffee/api/interpreter

# GoDaddy: production y http; no reemplazar PORT asignado por el hosting.
NODE_ENV=development
SERVER_PROTOCOL=https
# IP o CIDR del proxy confiable; loopback para Nginx local en VPS.
TRUST_PROXY=

# Dirección pública del sistema, usada para el enlace temporal que reciben los buscadores de imágenes.
PUBLIC_BASE_URL=
