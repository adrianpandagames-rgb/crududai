# Copia este archivo como .env y completa tus valores reales localmente.
# Nunca guardes claves reales en el repositorio.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=crudnodejs

# Bot de Telegram: IDs numéricos autorizados, separados por comas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Credencial exclusiva entre Python y Node; distinta del token de BotFather.
TELEGRAM_API_TOKEN=
TELEGRAM_API_BASE_URL=https://localhost:3443
TELEGRAM_API_CA_CERT=certs/runtime-server.crt

HOST=0.0.0.0
PORT=3600
HTTPS_PORT=3443

IMEI_API_KEY=tu_api_key_imei
IMEI_SERVICE_ID=0
PHONE_VALIDATION_ACCESS_KEY=tu_access_key_telefono

# Optional replacement TLS pair; configure both paths or leave both empty.
TLS_KEY_PATH=
TLS_CERT_PATH=

# Clave de servidor con Geocoding API habilitada (no se envía al navegador).
GOOGLE_GEOCODING_API_KEY=

# Fuente vial para calcular entrecalles. Para cargas grandes usa un proveedor propio.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Alternativa ante fallos temporales. Déjalo vacío para desactivar la alternativa.
OVERPASS_FALLBACK_API_URL=https://overpass.private.coffee/api/interpreter
